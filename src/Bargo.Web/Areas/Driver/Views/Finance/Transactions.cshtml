@model TransactionsVm
@{
    var balance = (long)ViewBag.Balance;
}
<div class="page-head">
    <div><h1><i class="bi bi-arrow-left-right"></i> تراکنش‌های کیف پول</h1><p>هر ردیف یک تغییر در موجودی است؛ ستون «مانده» موجودی پس از همان تراکنش را نشان می‌دهد.</p></div>
    <div class="actions"><span class="chip"><i class="bi bi-wallet2"></i> موجودی فعلی: @Fa.Toman(balance)</span></div>
</div>

<div class="tabs">
    <a asp-action="Transactions" class="@(Model.Kind is null ? "on" : "")">همه</a>
    @foreach (var k in Model.Kinds)
    {
        <a asp-action="Transactions" asp-route-kind="@k" class="@(Model.Kind == k ? "on" : "")">@WalletTxnKind.Label(k)</a>
    }
</div>

<div class="card2">
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>شماره</th><th>تاریخ</th><th>نوع</th><th>مبلغ</th><th>مانده</th><th>سفر</th><th>توضیح</th></tr></thead>
            <tbody>
            @foreach (var t in Model.Page.Rows)
            {
                <tr>
                    <td class="num">#@Fa.N(t.WalletTransactionId)</td>
                    <td class="nowrap">@Fa.Stamp(t.CreatedAt)</td>
                    <td>@WalletTxnKind.Label(t.Kind)</td>
                    <td><b class="num" style="color:@(t.Amount >= 0 ? "var(--ok)" : "var(--no)")">@(t.Amount >= 0 ? "+" : "−")@Fa.Toman(Math.Abs(t.Amount))</b></td>
                    <td class="num">@Fa.Toman(t.BalanceAfter)</td>
                    <td>@if (t.TripId is int tid) { <a class="lnk" href="/Driver/Trips/Detail/@tid">@t.TripCode</a> } else { <span class="muted">—</span> }</td>
                    <td class="muted">@(t.Note ?? "—")</td>
                </tr>
            }
            @if (Model.Page.Total == 0)
            {
                <tr><td colspan="7" class="empty"><i class="bi bi-arrow-left-right"></i>@(Model.Kind is null ? "هنوز تراکنشی ثبت نشده است." : $"تراکنشی از نوع «{WalletTxnKind.Label(Model.Kind)}» ندارید.")</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Page.Pager" />
</div>

@model List<CargoRow>
@{
    var total = Model.Sum(x => x.Trips);
    var totalDone = Model.Sum(x => x.Done);
    var totalTons = Model.Sum(x => x.Tons);
    var totalFare = Model.Sum(x => x.Fare);
    var maxTrips = Model.Count == 0 ? 0 : Model.Max(x => x.Trips);
    var maxTons = Model.Count == 0 ? 0m : Model.Max(x => x.Tons);
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-boxes"></i> بارهای حمل‌شده</h1>
        <p>نوع بارهایی که شرکت در بازه حمل کرده: تعداد سفر، تناژ تحویل‌شده و جمع کرایه — برای این‌که بدانید ناوگان روی چه باری بیشتر کار می‌کند.</p>
    </div>
</div>

<partial name="_ReportHead" />

<div class="stats">
    <div class="stat p"><div class="l"><i class="bi bi-tags"></i> نوع بار</div><div class="v">@Fa.N(Model.Count)</div></div>
    <div class="stat i"><div class="l"><i class="bi bi-signpost-split"></i> سفر</div><div class="v">@Fa.N(total)<small>@Fa.N(totalDone) تحویل‌شده</small></div></div>
    <div class="stat s"><div class="l"><i class="bi bi-box-seam"></i> تناژ تحویل‌شده</div><div class="v">@Fa.N(totalTons, 1)<small>تن</small></div></div>
    <div class="stat t"><div class="l"><i class="bi bi-cash"></i> جمع کرایه</div><div class="v">@Fa.Toman(totalFare)</div></div>
</div>

<div class="card2">
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>#</th><th>نوع بار</th><th style="width:22%">سفر</th><th>تحویل‌شده</th><th style="width:22%">تناژ تحویل‌شده</th><th>جمع کرایه (سفرهای غیرلغو)</th></tr></thead>
            <tbody>
            @{ var rank = 0; }
            @foreach (var c in Model)
            {
                rank++;
                <tr>
                    <td data-label="#" class="num">@Fa.N(rank)</td>
                    <td data-label="نوع بار"><b>@(string.IsNullOrWhiteSpace(c.CargoType) ? "نامشخص" : c.CargoType)</b></td>
                    <td data-label="سفر"><div class="small"><b>@Fa.N(c.Trips)</b> <span class="muted">(@Fa.N(total == 0 ? 0 : c.Trips * 100.0 / total)٪)</span></div><partial name="_Bar" model="new BarVm(c.Trips, maxTrips)" /></td>
                    <td data-label="تحویل‌شده" class="num">@Fa.N(c.Done)</td>
                    <td data-label="تناژ"><div class="small"><b>@Fa.N(c.Tons, 1)</b> تن</div><partial name="_Bar" model='new BarVm((double)c.Tons, (double)maxTons, "var(--ok)")' /></td>
                    <td data-label="جمع کرایه" class="nowrap">@Fa.Toman(c.Fare)</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="empty"><i class="bi bi-boxes"></i>در این بازه باری حمل نشده است.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

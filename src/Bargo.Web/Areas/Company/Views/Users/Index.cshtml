@model List<CompanyUserRow>
@inject CurrentUser Me
@{
    var active = (int)ViewBag.ActiveCount;
    var max = (int)ViewBag.MaxUsers;
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-person-gear"></i> کاربران شرکت</h1>
        <p>هر اقدام در پنل به نام یک کاربر مشخص ثبت می‌شود. عنوان فقط برچسب است؛ دسترسی واقعی از «تعیین سطح دسترسی» می‌آید.</p>
    </div>
    <div class="actions">
        <a class="btn2 pri" asp-action="Add"><i class="bi bi-person-plus"></i> تعریف کاربر</a>
        <a class="btn2 ghost" asp-action="Permissions"><i class="bi bi-shield-lock"></i> تعیین سطح دسترسی</a>
    </div>
</div>

<div class="card2">
    <div class="hd">
        <i class="bi bi-people"></i> فهرست کاربران
        <span class="end"><span class="chip">@Fa.N(active) فعال از @Fa.N(Model.Count)</span><span class="muted small">سقف @Fa.N(max) کاربر</span></span>
    </div>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>کاربر</th><th>موبایل</th><th>عنوان</th><th>دسترسی‌ها</th><th>وضعیت</th><th>آخرین ورود</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                var isMe = u.CompanyUserId == Me.Id;
                var confirmText = u.IsActive
                    ? "حساب «" + u.Name + "» غیرفعال شود؟ دیگر نمی‌تواند وارد پنل شود."
                    : "حساب «" + u.Name + "» دوباره فعال شود؟";
                <tr>
                    <td>
                        <b>@u.Name</b>
                        @if (u.IsOwner)
                        {
                            <span class="pill inf"><i class="bi bi-star-fill"></i> مدیر شرکت</span>
                        }
                        @if (isMe)
                        {
                            <span class="chip">شما</span>
                        }
                        <span class="sub">عضو از @Fa.Date(u.CreatedAt)</span>
                    </td>
                    <td class="num">@Fa.Digits(u.Mobile)</td>
                    <td>
                        @if (u.IsOwner)
                        {
                            <span>@CompanyLabels.UserTitle(u.Title)</span>
                        }
                        else
                        {
                            <form method="post" asp-action="SetTitle" asp-route-id="@u.CompanyUserId" class="inline">
                                <select name="title" onchange="this.form.submit()" title="تغییر عنوان" style="padding:5px 9px;border:1px solid #cdd5de;border-radius:8px;font:inherit;font-size:13px;background:#fff">
                                    @foreach (var t in CompanyLabels.AssignableTitles)
                                    {
                                        <option value="@t" selected="@(t == u.Title)">@CompanyLabels.UserTitle(t)</option>
                                    }
                                </select>
                            </form>
                        }
                    </td>
                    <td>
                        @if (u.Permissions == CompanyPermission.All)
                        {
                            <span class="pill ok">همهٔ بخش‌ها</span>
                        }
                        else if (u.Permissions == CompanyPermission.None)
                        {
                            <span class="muted">بدون دسترسی</span>
                        }
                        else
                        {
                            <div class="row-actions">
                                @foreach (var p in CompanyLabels.Permissions.Where(p => u.Permissions.HasFlag(p)))
                                {
                                    <span class="chip">@CompanyLabels.Permission(p)</span>
                                }
                            </div>
                        }
                    </td>
                    <td>@(u.IsActive ? Ui.Pill("فعال", "ok") : Ui.Pill("غیرفعال", "no"))</td>
                    <td class="nowrap">
                        @if (u.LastLoginAt is DateTime l)
                        {
                            @Fa.Ago(l)<span class="sub">@Fa.Stamp(l)</span>
                        }
                        else
                        {
                            <span class="muted">هنوز وارد نشده</span>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            <a class="btn2 ghost sm" asp-action="Permissions" asp-fragment="u@(u.CompanyUserId)"><i class="bi bi-shield-lock"></i> دسترسی</a>
                            @if (!u.IsOwner && !isMe)
                            {
                                <form method="post" asp-action="ToggleActive" asp-route-id="@u.CompanyUserId" class="inline"
                                      data-confirm="@confirmText">
                                    <button class="btn2 @(u.IsActive ? "ghost" : "soft") sm">
                                        <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i> @(u.IsActive ? "غیرفعال" : "فعال‌سازی")
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="empty"><i class="bi bi-people"></i>هنوز کاربری برای شرکت تعریف نشده است.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card2">
    <div class="hd"><i class="bi bi-info-circle"></i> عنوان‌ها و دسترسی پیشنهادی</div>
    <div class="bd">
        <dl class="kv">
            @foreach (var t in CompanyLabels.UserTitles)
            {
                var d = CompanyLabels.DefaultFor(t);
                <dt>@CompanyLabels.UserTitle(t)</dt>
                <dd>@(d == CompanyPermission.All ? "همهٔ بخش‌ها" : string.Join("، ", CompanyLabels.Permissions.Where(p => d.HasFlag(p)).Select(CompanyLabels.Permission)))</dd>
            }
        </dl>
        <p class="muted small" style="margin:12px 0 0">این‌ها فقط پیش‌فرض فرم «تعریف کاربر» هستند؛ دسترسی هر کاربر را می‌توانید جداگانه تغییر دهید.</p>
    </div>
</div>

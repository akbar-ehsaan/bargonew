@model OpsDashboardVm
@{
    var approved = Model.CompanyStatus == AccountStatus.Approved;
    var expired = Model.Alerts.Count(a => a.IsExpired);
    var soon = Model.Alerts.Count - expired;
    var topAlerts = Model.Alerts.Take(8).ToList();
    var inboxTotal = Model.DirectRequests + Model.PendingOffers + Model.PendingDrivers;
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-speedometer2"></i> @Model.CompanyName @Ui.AccountPill(Model.CompanyStatus)</h1>
        <p>امروز چه کاری منتظر شماست: صف تخصیص، سفرهای در راه، درخواست‌های رسیده و مدارک رو به انقضا.</p>
    </div>
    <div class="actions">
        @if (Model.CanLoads)
        {
            <a class="btn2 ghost" href="/Company/Loads/Market"><i class="bi bi-shop"></i> بازار بار</a>
            <a class="btn2 pri" href="/Company/Loads/Create"><i class="bi bi-plus-lg"></i> ثبت بار</a>
        }
        @if (Model.CanDispatch)
        {
            <a class="btn2 ghost" href="/Company/Dispatch"><i class="bi bi-diagram-3"></i> تخصیص</a>
        }
    </div>
</div>

@if (!approved)
{
    <div class="alert2 @(Model.CompanyStatus == AccountStatus.Pending ? "warn" : "err")" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div class="grow">
            @switch (Model.CompanyStatus)
            {
                case AccountStatus.Pending:
                    <b>حساب شرکت در انتظار تأیید مدیر بارگو است.</b>
                    <div>تا تأیید، فقط داشبورد، مشخصات و مدارک شرکت، پیام‌ها و پشتیبانی در دسترس است. مدارک شرکت (آگهی تأسیس، مجوز فعالیت، کارت ملی مدیرعامل) را بارگذاری کنید تا بررسی آغاز شود.</div>
                    break;
                case AccountStatus.Rejected:
                    <b>درخواست عضویت شرکت رد شده است.</b>
                    <div>پس از رفع ایراد، مدارک را دوباره بارگذاری کنید تا بررسی مجدد انجام شود.</div>
                    break;
                default:
                    <b>حساب شرکت تعلیق شده است.</b>
                    <div>فعالیت پنل تا رفع تعلیق متوقف است؛ برای پیگیری تیکت ثبت کنید.</div>
                    break;
            }
            @if (!string.IsNullOrWhiteSpace(Model.StatusReason))
            {
                <div class="small" style="margin-top:4px">توضیح مدیر: @Model.StatusReason</div>
            }
            <div class="row-actions" style="margin-top:8px">
                <a class="btn2 sm ghost" href="/Company/Account/Documents"><i class="bi bi-folder2-open"></i> مدارک شرکت</a>
                <a class="btn2 sm ghost" href="/Company/Tickets/Create"><i class="bi bi-life-preserver"></i> ثبت تیکت</a>
            </div>
        </div>
    </div>
}

<div class="stats @(Model.Stats.Count == 6 ? "cols3" : "")">
    @foreach (var s in Model.Stats)
    {
        <a class="stat @s.Kind" href="@(s.Href ?? "#")">
            <div class="l"><i class="bi @s.Icon"></i> @s.Label</div>
            <div class="v">
                @s.Value
                @if (s.Unit is not null)
                {
                    <small>@s.Unit</small>
                }
            </div>
        </a>
    }
</div>

<div class="grid-side">
    <div class="stack">
        <div class="card2">
            <div class="hd">
                <i class="bi bi-hourglass-split"></i> صف تخصیص
                <span class="end">
                    <span class="muted small">@Fa.N(Model.QueueTotal) سفر</span>
                    @if (Model.CanDispatch)
                    {
                        <a class="btn2 sm ghost" href="/Company/Dispatch">همهٔ صف</a>
                    }
                </span>
            </div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>سفر</th><th>بار</th><th>مسیر</th><th>حرکت</th><th>راننده</th><th>وضعیت</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.Queue)
                    {
                        var l = t.Load!;
                        <tr data-href="/Company/Trips/Detail/@t.TripId">
                            <td><a class="lnk num" href="/Company/Trips/Detail/@t.TripId">@t.Code</a></td>
                            <td><b>@l.Title</b><span class="sub">@l.CargoType · @OpsLabels.Ton(l.WeightTon) تن</span></td>
                            <td>@Ui.Route(l.OriginCity?.Name, l.DestCity?.Name)</td>
                            <td class="nowrap">@Fa.Stamp(t.ScheduledDepartureAt ?? l.LoadingFrom)</td>
                            <td>
                                @if (t.Driver is not null)
                                {
                                    @t.Driver.FullName
                                }
                                else
                                {
                                    <span class="chip">تخصیص نیافته</span>
                                }
                            </td>
                            <td>@Ui.TripPill(t.Status)</td>
                            <td>
                                @if (Model.CanDispatch)
                                {
                                    <a class="btn2 soft sm" href="/Company/Dispatch/Assign/@t.TripId"><i class="bi bi-person-check"></i> تخصیص</a>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Queue.Count == 0)
                    {
                        <tr><td colspan="7" class="empty"><i class="bi bi-check2-all"></i>صف تخصیص خالی است؛ همهٔ سفرها راننده دارند.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card2">
            <div class="hd">
                <i class="bi bi-truck"></i> سفرهای در راه
                <span class="end">
                    <span class="muted small">@Fa.N(Model.LiveTotal) سفر</span>
                    <a class="btn2 sm ghost" href="/Company/Monitoring">نقشهٔ آنلاین</a>
                    <a class="btn2 sm ghost" href="/Company/Trips?tab=current">همهٔ سفرهای جاری</a>
                </span>
            </div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>سفر</th><th>مسیر</th><th>راننده / خودرو</th><th>مرحله</th><th>آخرین موقعیت</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.Live)
                    {
                        var l = t.Load!;
                        <tr data-href="/Company/Trips/Detail/@t.TripId">
                            <td><a class="lnk num" href="/Company/Trips/Detail/@t.TripId">@t.Code</a><span class="sub">@l.Title</span></td>
                            <td>@Ui.Route(l.OriginCity?.Name, l.DestCity?.Name)</td>
                            <td>
                                @(t.Driver?.FullName ?? "—")
                                @if (t.Vehicle is not null)
                                {
                                    <span class="sub"><span class="plate">@t.Vehicle.PlateNo</span></span>
                                }
                            </td>
                            <td>@Ui.TripPill(t.Status)</td>
                            <td class="nowrap">
                                @if (t.LastPointAt is DateTime lp)
                                {
                                    @Fa.Ago(lp)
                                    if (t.EtaAt is DateTime eta)
                                    {
                                        <span class="sub">رسیدن حدود @Fa.Stamp(eta)</span>
                                    }
                                }
                                else
                                {
                                    <span class="muted">موقعیتی نرسیده</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Live.Count == 0)
                    {
                        <tr><td colspan="5" class="empty"><i class="bi bi-truck"></i>در حال حاضر هیچ سفری در راه نیست.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="stack">
        <div class="card2">
            <div class="hd"><i class="bi bi-inbox"></i> کار ورودی <span class="end">@(inboxTotal > 0 ? Ui.Pill(Fa.N(inboxTotal) + " مورد", "wait") : Ui.Pill("خالی", "mut"))</span></div>
            <div class="bd">
                @if (Model.CanLoads)
                {
                    <a class="kvrow" href="/Company/Loads/Incoming"><span><i class="bi bi-envelope-paper"></i> درخواست‌های مستقیم صاحبان بار</span><b>@Fa.N(Model.DirectRequests)</b></a>
                    <a class="kvrow" href="/Company/Loads/Incoming"><span><i class="bi bi-tags"></i> پیشنهادهای شرکت در انتظار پاسخ</span><b>@Fa.N(Model.PendingOffers)</b></a>
                    <a class="kvrow" href="/Company/Loads/Market"><span><i class="bi bi-shop"></i> بارهای باز در بازار</span><b>@Fa.N(Model.MarketLoads)</b></a>
                }
                @if (Model.CanDrivers)
                {
                    <a class="kvrow" href="/Company/Drivers?status=@AccountStatus.Pending"><span><i class="bi bi-person-badge"></i> رانندگان در انتظار تأیید</span><b>@Fa.N(Model.PendingDrivers)</b></a>
                }
                @if (!Model.CanLoads && !Model.CanDrivers)
                {
                    <div class="muted small">دسترسی شما به بارها و رانندگان تعریف نشده است؛ مدیر شرکت می‌تواند از «کاربران شرکت» آن را بدهد.</div>
                }
            </div>
        </div>

        <div class="card2">
            <div class="hd">
                <i class="bi bi-alarm"></i> مدارک رو به انقضا
                <span class="end">
                    @if (expired > 0)
                    {
                        @Ui.Pill(Fa.N(expired) + " منقضی", "no")
                    }
                    @if (soon > 0)
                    {
                        @Ui.Pill(Fa.N(soon) + " نزدیک انقضا", "wait")
                    }
                </span>
            </div>
            <div class="bd">
                @foreach (var a in topAlerts)
                {
                    <a class="kvrow" href="@a.Href">
                        <span>
                            <i class="bi @(a.SubjectKind == OwnerKind.Vehicle ? "bi-truck-front" : "bi-person-badge")"></i>
                            @a.KindLabel — @a.Subject
                        </span>
                        @Ui.Pill(Fa.Date(a.ExpiresAt), a.IsExpired ? "no" : "wait")
                    </a>
                }
                @if (Model.Alerts.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-shield-check"></i><b>هشداری نیست</b>مدارک رانندگان و خودروهای شرکت معتبرند.</div>
                }
                else if (Model.Alerts.Count > topAlerts.Count)
                {
                    <div class="form-actions"><a class="btn2 ghost block" href="/Company/Fleet/Alerts">همهٔ @Fa.N(Model.Alerts.Count) هشدار</a></div>
                }
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-lightning"></i> دسترسی سریع</div>
            <div class="bd">
                <div class="row-actions">
                    @if (Model.CanDrivers)
                    {
                        <a class="btn2 ghost sm" href="/Company/Drivers/Online"><i class="bi bi-broadcast"></i> رانندگان آنلاین</a>
                        <a class="btn2 ghost sm" href="/Company/Drivers/Add"><i class="bi bi-person-plus"></i> افزودن راننده</a>
                    }
                    @if (Model.CanFleet)
                    {
                        <a class="btn2 ghost sm" href="/Company/Fleet"><i class="bi bi-truck-front"></i> خودروها</a>
                        <a class="btn2 ghost sm" href="/Company/Fleet/Add"><i class="bi bi-plus-circle"></i> افزودن خودرو</a>
                    }
                    <a class="btn2 ghost sm" href="/Company/Waybills"><i class="bi bi-files"></i> بارنامه‌ها</a>
                    @if (Model.CanFinance)
                    {
                        <a class="btn2 ghost sm" href="/Company/Finance"><i class="bi bi-wallet2"></i> کیف پول</a>
                    }
                    <a class="btn2 ghost sm" href="/Company/Customers"><i class="bi bi-buildings"></i> مشتریان</a>
                </div>
            </div>
        </div>
    </div>
</div>

@model ShipperOrderVm
@{
    var t = Model.Trip;
    var ld = t.Load!;
    var wbill = t.Waybill;
    var isLive = TripStatus.Live.Contains(t.Status);
    var isDone = TripStatus.Done.Contains(t.Status);
    var isCancelled = t.Status == TripStatus.Cancelled;
    var canPay = !t.IsPaid && !isCancelled;
    var shortfall = Math.Max(0L, t.TotalPayable - Model.WalletBalance);
    var here = Url.Action("Detail", new { id = t.TripId }) ?? "";
    var backTab = isDone ? "done" : isCancelled ? "cancelled" : "current";
    var receiverMobile = ld.ReceiverMobile ?? ld.Shipper?.Mobile;
    var hasInsuranceDoc = Model.Documents.Any(dx => dx.Kind == TripDocumentKind.CargoInsurance);
    var docCount = Model.Documents.Count + (wbill is null ? 0 : 1);
    var threadUrl = Url.Action("Thread", "Messages", new { key = "trip:" + t.TripId });
    string MethodLabel(string m) => m switch { "gateway" => "درگاه بانکی", "manual" => "ثبت دستی", _ => "کیف پول" };
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-receipt"></i> سفارش <span class="num">@t.Code</span> @Ui.TripPill(t.Status)@if (t.IsProblem) { @Ui.Pill("در حال بررسی پشتیبانی", "wait") }</h1>
        <p>@Ui.Route(ld.OriginCity?.Name, ld.DestCity?.Name) · @ld.Title · بار <a class="num" href="/Shipper/Loads/Detail/@ld.LoadId">@ld.Code</a> · ساخته‌شده @Fa.Ago(t.CreatedAt)</p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" asp-action="Index" asp-route-tab="@backTab"><i class="bi bi-arrow-right"></i> فهرست سفارش‌ها</a>
        @if (!isCancelled)
        {
            <a class="btn2 soft" href="/Shipper/Tracking?tripId=@t.TripId"><i class="bi bi-geo-alt"></i> رهگیری بار</a>
        }
        <a class="btn2 ghost" href="@threadUrl"><i class="bi bi-chat-dots"></i> گفتگوی سفر</a>
    </div>
</div>

@if (t.IsProblem && !string.IsNullOrEmpty(t.ProblemNote))
{
    <div class="alert2 warn"><i class="bi bi-exclamation-triangle-fill"></i><div class="grow">این سفر برای بررسی به پشتیبانی بارگو ارجاع شده است: @t.ProblemNote</div></div>
}
@if (t.Status == TripStatus.Unloaded)
{
    <div class="alert2 info">
        <i class="bi bi-shield-lock"></i>
        <div class="grow">
            <b>بار در مقصد تخلیه شد؛ تحویل فقط با کد انجام می‌شود.</b>
            کد تحویل@(t.DeliveryOtpSentAt is DateTime otpSent ? " " + Fa.Ago(otpSent) : "") به @(string.IsNullOrEmpty(receiverMobile) ? "گیرنده" : ShipperUi.MaskMobile(receiverMobile)) پیامک شده و در اعلان‌های شما هم آمده است. این کد را فقط پس از تحویل کامل و سالم بار به راننده بدهید؛ با ثبت کد، تحویل قطعی می‌شود. اگر کد نرسیده، تا دو دقیقه پس از آخرین ارسال صبر کنید و دوباره بفرستید.
        </div>
        <form method="post" asp-action="ResendCode">
            <input type="hidden" name="id" value="@t.TripId" />
            <button type="submit" class="btn2 soft sm"><i class="bi bi-arrow-repeat"></i> ارسال دوبارهٔ کد</button>
        </form>
    </div>
}
@if (canPay)
{
    <div class="alert2 warn">
        <i class="bi bi-credit-card"></i>
        <div class="grow">کرایه و هزینه‌های این سفر (@Fa.Toman(t.TotalPayable)) هنوز پرداخت نشده است. مبلغ پرداختی تا تحویل بار نزد بارگو امانت می‌ماند.</div>
        <a class="btn2 soft sm" href="#pay">پرداخت کرایه</a>
    </div>
}
@if (Model.CanRate)
{
    <div class="alert2 info">
        <i class="bi bi-star"></i>
        <div class="grow">بار تحویل شد. با امتیاز به @Model.RateTarget به صاحبان بار دیگر در انتخاب حمل‌کننده کمک کنید.</div>
        <a class="btn2 soft sm" href="#rate">ثبت امتیاز</a>
    </div>
}

<div class="grid-side">
    <div class="stack">
        <div class="card2">
            <div class="bd"><partial name="_TripSteps" model="t" /></div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-box-seam"></i> بار و مسیر <span class="end"><a class="small" href="/Shipper/Loads/Detail/@ld.LoadId">مشاهدهٔ بار</a></span></div>
            <div class="bd">
                <dl class="kv">
                    <dt>عنوان</dt><dd>@ld.Title</dd>
                    <dt>کالا</dt><dd>@ld.CargoType@(string.IsNullOrEmpty(ld.Packaging) ? "" : " · " + ld.Packaging) · @ShipperUi.Ton(ld.WeightTon)</dd>
                    <dt>مبدا</dt><dd>@ld.OriginCity?.Name — @ld.OriginAddress</dd>
                    <dt>مقصد</dt><dd>@ld.DestCity?.Name — @ld.DestAddress</dd>
                    <dt>زمان بارگیری</dt><dd>@Fa.Stamp(ld.LoadingFrom)</dd>
                    <dt>زمان حرکت</dt><dd>@Fa.Stamp(t.ScheduledDepartureAt)@(t.StartedAt is DateTime startedAt ? " · حرکت واقعی " + Fa.Stamp(startedAt) : "")</dd>
                    <dt>مسافت</dt><dd>@(t.PlannedKm is double plannedKm ? Fa.N(plannedKm) + " کیلومتر" : "—")@(t.TravelledKm > 0 ? $" · {Fa.N(t.TravelledKm)} کیلومتر طی‌شده" : "")</dd>
                    @if (t.Status == TripStatus.InTransit && t.EtaAt is DateTime etaAt)
                    {
                        <dt>رسیدن تقریبی</dt><dd>@Fa.Stamp(etaAt)</dd>
                    }
                    @if (isLive)
                    {
                        <dt>آخرین موقعیت</dt>
                        <dd>@(t.LastPointAt is DateTime lastAt ? Fa.Ago(lastAt) : "هنوز ثبت نشده") · <a href="/Shipper/Tracking?tripId=@t.TripId">روی نقشه</a></dd>
                    }
                    @if (t.LoadedAt is DateTime loadedAt)
                    {
                        <dt>بارگیری</dt><dd>@Fa.Stamp(loadedAt)</dd>
                    }
                    @if (t.DeliveredAt is DateTime deliveredAt)
                    {
                        <dt>تحویل</dt><dd>@Fa.Stamp(deliveredAt)</dd>
                    }
                    <dt>گیرنده</dt><dd>@(ld.ReceiverName ?? "خودتان") <span class="num">@Fa.Digits(ld.ReceiverMobile)</span></dd>
                    <dt>بیمهٔ بار</dt><dd>@(ld.InsuranceRequested ? (hasInsuranceDoc ? "درخواست‌شده · بیمه‌نامه بارگذاری شده" : "درخواست‌شده · بیمه‌نامه هنوز بارگذاری نشده") : "درخواست نشده")</dd>
                    @if (isCancelled)
                    {
                        <dt>لغو</dt><dd>@Fa.Stamp(t.CancelledAt) — @(t.CancelReason ?? "—")</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-folder2-open"></i> بارنامه و اسناد سفر <span class="end muted small">@Fa.N(docCount) سند</span></div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>نوع</th><th>عنوان</th><th>ثبت</th><th>فایل</th></tr></thead>
                    <tbody>
                    @if (wbill is not null)
                    {
                        <tr>
                            <td data-label="نوع">بارنامه</td>
                            <td data-label="عنوان"><b>شمارهٔ <span class="num">@Fa.Digits(wbill.Number)</span></b><span class="sub">@Ui.Pill(ShipperUi.WaybillStatusLabel(wbill.Status), ShipperUi.WaybillStatusTone(wbill.Status))</span></td>
                            <td class="nowrap" data-label="ثبت">@Fa.Stamp(wbill.IssuedAt)<span class="sub">@OwnerKind.Label(wbill.IssuedByKind)</span></td>
                            <td data-label="فایل">
                                @if (!string.IsNullOrEmpty(wbill.FilePath))
                                {
                                    <a class="btn2 ghost sm" href="@DocumentStorage.Url(wbill.FilePath)" target="_blank" rel="noopener"><i class="bi bi-download"></i> مشاهده</a>
                                }
                                else
                                {
                                    <span class="muted">فقط شماره ثبت شده</span>
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var doc in Model.Documents)
                    {
                        <tr>
                            <td data-label="نوع">@TripDocumentKind.Label(doc.Kind)</td>
                            <td data-label="عنوان"><b>@(string.IsNullOrEmpty(doc.Title) ? TripDocumentKind.Label(doc.Kind) : doc.Title)</b></td>
                            <td class="nowrap" data-label="ثبت">@Fa.Stamp(doc.CreatedAt)<span class="sub">@OwnerKind.Label(doc.UploadedByKind)</span></td>
                            <td data-label="فایل">
                                @if (!string.IsNullOrEmpty(doc.FilePath))
                                {
                                    <a class="btn2 ghost sm" href="@DocumentStorage.Url(doc.FilePath)" target="_blank" rel="noopener"><i class="bi bi-download"></i> مشاهده</a>
                                }
                                else
                                {
                                    <span class="muted">بدون فایل</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (docCount == 0)
                    {
                        <tr><td colspan="4" class="empty"><i class="bi bi-folder2-open"></i>هنوز بارنامه یا سندی برای این سفر ثبت نشده است. حمل‌کننده پس از بارگیری شمارهٔ بارنامه را ثبت می‌کند و رسیدها را از اپ بارگذاری می‌کند.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (ld.InsuranceRequested && !hasInsuranceDoc && !isCancelled)
            {
                <div class="bd">
                    <p class="muted small" style="margin:0"><i class="bi bi-shield-exclamation"></i> برای این بار بیمه خواسته‌اید ولی هنوز بیمه‌نامه‌ای روی سفر بارگذاری نشده است. پیش از بارگیری از <a href="@threadUrl">گفتگوی سفر</a> پیگیری کنید.</p>
                </div>
            }
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-activity"></i> رویدادهای سفر <span class="end muted small">@Fa.N(Model.Events.Count) رویداد</span></div>
            <div class="bd"><partial name="_TripEvents" model="Model.Events" /></div>
        </div>
    </div>

    <div class="stack">
        <div class="card2" id="pay">
            <div class="hd"><i class="bi bi-cash-stack"></i> کرایه و پرداخت</div>
            <div class="bd">
                <div class="kvrow"><span>کرایهٔ توافق‌شده</span><b>@Fa.Toman(t.Fare)</b></div>
                @if (t.LoadingFee > 0)
                {
                    <div class="kvrow"><span>هزینهٔ بارگیری</span><b>@Fa.Toman(t.LoadingFee)</b></div>
                }
                @if (t.UnloadingFee > 0)
                {
                    <div class="kvrow"><span>هزینهٔ تخلیه</span><b>@Fa.Toman(t.UnloadingFee)</b></div>
                }
                @if (t.WaybillFee > 0)
                {
                    <div class="kvrow"><span>هزینهٔ بارنامه</span><b>@Fa.Toman(t.WaybillFee)</b></div>
                }
                @if (t.Vat > 0)
                {
                    <div class="kvrow"><span>ارزش افزوده (@Fa.N(t.VatPercent, 1)٪)</span><b>@Fa.Toman(t.Vat)</b></div>
                }
                @if (t.TotalPayable != t.Fare)
                {
                    <div class="kvrow"><span>جمع قابل پرداخت</span><b>@Fa.Toman(t.TotalPayable)</b></div>
                }
                <div class="kvrow">
                    <span>وضعیت پرداخت</span>
                    @if (t.IsPaid)
                    {
                        @Ui.Pill(t.Status == TripStatus.Settled ? "پرداخت و تسویه‌شده" : "پرداخت‌شده · امانت نزد بارگو", "ok")
                    }
                    else if (isCancelled)
                    {
                        @Ui.Pill(Model.Refunds.Count > 0 ? "مسترد‌شده" : "پرداخت نشده", "mut")
                    }
                    else
                    {
                        @Ui.Pill("در انتظار پرداخت", "wait")
                    }
                </div>
                @if (t.SettledAt is DateTime settledAt)
                {
                    <div class="kvrow"><span>تسویه با حمل‌کننده</span><b>@Fa.Stamp(settledAt)</b></div>
                }

                @if (canPay)
                {
                    <div class="kvrow"><span>موجودی کیف پول</span><b>@Fa.Toman(Model.WalletBalance)</b></div>
                    @if (shortfall == 0)
                    {
                        <form method="post" asp-controller="Finance" asp-action="Pay" data-confirm="کرایه و هزینه‌های سفر @t.Code به مبلغ @Fa.Toman(t.TotalPayable) از کیف پول پرداخت شود؟">
                            <input type="hidden" name="tripId" value="@t.TripId" />
                            <input type="hidden" name="returnUrl" value="@here" />
                            <div class="form-actions"><button type="submit" class="btn2 pri block"><i class="bi bi-wallet2"></i> پرداخت از کیف پول</button></div>
                        </form>
                    }
                    else
                    {
                        <div class="alert2 warn" style="margin-top:12px"><i class="bi bi-wallet2"></i><div class="grow">موجودی کیف پول برای این پرداخت کافی نیست؛ @Fa.Toman(shortfall) کم دارید.</div></div>
                        <div class="form-actions"><a class="btn2 pri block" href="/Shipper/Finance"><i class="bi bi-plus-circle"></i> شارژ کیف پول</a></div>
                    }
                    <p class="muted small" style="margin:10px 0 0">کرایه تا تحویل بار نزد بارگو امانت می‌ماند و پس از ثبت تحویل با کد، به حمل‌کننده پرداخت می‌شود. اگر سفر لغو شود، مبلغ به کیف پول شما برمی‌گردد.</p>
                }

                @if (Model.Payments.Count > 0)
                {
                    <div class="sec-title" style="margin-top:14px">پرداخت‌ها</div>
                    @foreach (var pay in Model.Payments)
                    {
                        <div class="kvrow">
                            <span>@Fa.Stamp(pay.PaidAt ?? pay.CreatedAt) · @MethodLabel(pay.Method)</span>
                            <b>@Fa.Toman(pay.Amount) @Ui.PaymentPill(pay.Status)</b>
                        </div>
                    }
                }
                @if (Model.Invoices.Count > 0)
                {
                    <div class="sec-title" style="margin-top:14px">فاکتورها</div>
                    @foreach (var inv in Model.Invoices)
                    {
                        <div class="kvrow">
                            <span><span class="num">@Fa.Digits(inv.No)</span> · @ShipperUi.InvoiceKindLabel(inv.Kind)</span>
                            <b>@Fa.Toman(inv.Total)</b>
                        </div>
                    }
                    <div class="form-actions" style="margin-top:8px"><a class="btn2 ghost sm" href="/Shipper/Finance/Invoices"><i class="bi bi-receipt-cutoff"></i> همهٔ فاکتورها</a></div>
                }
                @if (Model.Refunds.Count > 0)
                {
                    <div class="sec-title" style="margin-top:14px">استرداد</div>
                    @foreach (var rf in Model.Refunds)
                    {
                        <div class="kvrow">
                            <span>@Fa.Stamp(rf.DoneAt ?? rf.CreatedAt)</span>
                            <b>@Fa.Toman(rf.Amount) @Ui.Pill(ShipperUi.RefundLabel(rf.Status), ShipperUi.RefundTone(rf.Status))</b>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-person-badge"></i> حمل‌کننده</div>
            <div class="bd">
                <div class="kvrow"><span>نوع</span><b>@CarrierKind.Label(t.CarrierKind)</b></div>
                @if (!t.IsPaid)
                {
                    <div class="alert2 info"><i class="bi bi-incognito"></i>
                        <div class="grow">@Privacy.HiddenNote</div>
                    </div>
                    <div class="form-actions" style="margin-top:12px">
                        <a class="btn2 ghost sm" href="@threadUrl"><i class="bi bi-chat-dots"></i> پیام به حمل‌کننده</a>
                    </div>
                }
                else
                {
                @if (t.Company is { } carrierCo)
                {
                    <div class="kvrow"><span>شرکت</span><b>@carrierCo.Name</b></div>
                    <div class="kvrow"><span>تلفن شرکت</span><b class="num"><a href="tel:@(carrierCo.Phone ?? carrierCo.Mobile)">@Fa.Digits(carrierCo.Phone ?? carrierCo.Mobile)</a></b></div>
                    <div class="kvrow"><span>امتیاز شرکت</span><b>@Ui.Stars(carrierCo.RatingAvg, carrierCo.RatingCount)</b></div>
                }
                @if (t.Driver is { } carrierDrv)
                {
                    <div class="kvrow"><span>راننده</span><b>@carrierDrv.FullName</b></div>
                    <div class="kvrow"><span>موبایل راننده</span><b class="num"><a href="tel:@carrierDrv.Mobile">@Fa.Digits(carrierDrv.Mobile)</a></b></div>
                    <div class="kvrow"><span>امتیاز راننده</span><b>@Ui.Stars(carrierDrv.RatingAvg, carrierDrv.RatingCount)</b></div>
                }
                else
                {
                    <div class="kvrow"><span>راننده</span><b class="chip">هنوز تعیین نشده</b></div>
                }
                @if (t.Vehicle is { } carrierVeh)
                {
                    <div class="kvrow"><span>خودرو</span><b><span class="plate">@carrierVeh.PlateNo</span></b></div>
                    <div class="kvrow"><span>نوع خودرو</span><b>@(carrierVeh.VehicleType?.Name ?? "—") · @ShipperUi.Ton(carrierVeh.CapacityTon)</b></div>
                }
                else
                {
                    <div class="kvrow"><span>خودرو</span><b class="chip">هنوز تعیین نشده</b></div>
                }
                @if (t.Status is TripStatus.AwaitingAssignment or TripStatus.Assigned)
                {
                    <p class="muted small" style="margin:10px 0 0">@(t.Status == TripStatus.AwaitingAssignment ? "شرکت حمل‌کننده هنوز راننده و خودرو را برای این سفر تعیین نکرده است." : "راننده تعیین شده و منتظر قبول مأموریت از اپ است.")</p>
                }
                @if (Model.AssignmentChanges > 0)
                {
                    <p class="muted small" style="margin:10px 0 0"><i class="bi bi-arrow-repeat"></i> رانندهٔ این سفر @Fa.N(Model.AssignmentChanges) بار تعویض شده است؛ جزئیات در رویدادهای سفر آمده است.</p>
                }
                <div class="form-actions" style="margin-top:12px">
                    <a class="btn2 ghost sm" href="@threadUrl"><i class="bi bi-chat-dots"></i> پیام به حمل‌کننده</a>
                </div>
                }
            </div>
        </div>

        @if (Model.CanRate)
        {
            <div class="card2" id="rate">
                <div class="hd"><i class="bi bi-star"></i> امتیاز به @Model.RateTarget</div>
                <div class="bd">
                    <form method="post" asp-controller="Drivers" asp-action="Rate">
                        <input type="hidden" name="tripId" value="@t.TripId" />
                        <input type="hidden" name="returnUrl" value="@here" />
                        <div class="fld">
                            <label>امتیاز <span class="req">*</span></label>
                            <select name="score" required>
                                <option value="5">۵ — عالی</option>
                                <option value="4">۴ — خوب</option>
                                <option value="3">۳ — متوسط</option>
                                <option value="2">۲ — ضعیف</option>
                                <option value="1">۱ — خیلی بد</option>
                            </select>
                        </div>
                        <div class="fld" style="margin-top:10px">
                            <label>نظر (اختیاری)</label>
                            <textarea name="comment" rows="3" maxlength="1000" placeholder="وقت‌شناسی، سلامت بار، برخورد راننده"></textarea>
                        </div>
                        <div class="form-actions"><button type="submit" class="btn2 pri block"><i class="bi bi-star-fill"></i> ثبت امتیاز</button></div>
                    </form>
                    <p class="muted small" style="margin:10px 0 0">امتیاز پس از ثبت قابل ویرایش نیست. <a href="/Shipper/Drivers/Rate">همهٔ امتیازدهی‌ها</a></p>
                </div>
            </div>
        }
        else if (Model.MyRating is { } myRating)
        {
            <div class="card2" id="rate">
                <div class="hd"><i class="bi bi-star-fill"></i> امتیاز شما</div>
                <div class="bd">
                    <div class="kvrow"><span>به @Model.RateTarget</span><b><span class="stars"><i class="bi bi-star-fill"></i> @Fa.N(myRating.Score) از ۵</span></b></div>
                    <div class="kvrow"><span>ثبت</span><b>@Fa.Stamp(myRating.CreatedAt)</b></div>
                    @if (!string.IsNullOrEmpty(myRating.Comment))
                    {
                        <p class="small" style="margin:10px 0 0">«@myRating.Comment»</p>
                    }
                </div>
            </div>
        }

        <div class="card2">
            <div class="hd"><i class="bi bi-life-preserver"></i> پیگیری و شکایت</div>
            <div class="bd">
                <div class="form-actions" style="margin-top:0">
                    @if (!isCancelled)
                    {
                        <a class="btn2 ghost sm" href="/Shipper/Tracking?tripId=@t.TripId"><i class="bi bi-geo-alt"></i> رهگیری</a>
                    }
                    @if (Model.PointCount > 0)
                    {
                        <a class="btn2 ghost sm" href="/Shipper/Tracking/History?tripId=@t.TripId"><i class="bi bi-clock-history"></i> سوابق موقعیت (@Fa.N(Model.PointCount))</a>
                    }
                    <a class="btn2 ghost sm" href="/Shipper/Complaints/Create?tripId=@t.TripId"><i class="bi bi-exclamation-octagon"></i> ثبت شکایت</a>
                </div>
                @if (Model.Complaints.Count == 0)
                {
                    <p class="muted small" style="margin:12px 0 0">برای این سفر شکایتی ثبت نکرده‌اید. در صورت تأخیر، خسارت یا اختلاف مالی، شکایت را به همین سفر گره بزنید تا پرونده کامل باشد.</p>
                }
                else
                {
                    <div class="sec-title" style="margin-top:14px">شکایت‌های این سفر</div>
                    @foreach (var cp in Model.Complaints)
                    {
                        <div class="kvrow">
                            <span><a class="num" href="/Shipper/Complaints/Detail/@cp.ComplaintId">@cp.Code</a> · @cp.Title</span>
                            @Ui.ComplaintPill(cp.Status)
                        </div>
                    }
                }
            </div>
        </div>

        @if (Model.CanCancel)
        {
            <div class="card2">
                <div class="hd"><i class="bi bi-x-octagon"></i> لغو سفارش</div>
                <div class="bd">
                    <form method="post" asp-action="Cancel" data-confirm="سفارش @t.Code لغو شود؟ این کار برگشت‌پذیر نیست.">
                        <input type="hidden" name="id" value="@t.TripId" />
                        <div class="fld">
                            <label>علت لغو <span class="req">*</span></label>
                            <textarea name="reason" rows="2" required maxlength="500"></textarea>
                        </div>
                        <p class="muted small">با لغو، بار <span class="num">@ld.Code</span> هم لغو می‌شود و حمل‌کننده باخبر می‌شود.@(t.IsPaid ? $" مبلغ پرداخت‌شده ({Fa.Toman(t.TotalPayable)}) بی‌درنگ به کیف پول شما برمی‌گردد." : "")</p>
                        <div class="form-actions"><button type="submit" class="btn2 red block"><i class="bi bi-x-octagon"></i> لغو سفارش</button></div>
                    </form>
                </div>
            </div>
        }
        else if (!isDone && !isCancelled)
        {
            <div class="card2">
                <div class="hd"><i class="bi bi-x-octagon"></i> لغو سفارش</div>
                <div class="bd">
                    <p class="muted small" style="margin:0">راننده حرکت کرده است و از این مرحله لغو سفر فقط با بررسی پشتیبانی بارگو ممکن است.</p>
                    <div class="form-actions"><a class="btn2 ghost sm" href="/Shipper/Tickets/Create?category=cargo_issue&tripId=@t.TripId"><i class="bi bi-inbox"></i> درخواست به پشتیبانی</a></div>
                </div>
            </div>
        }
    </div>
</div>

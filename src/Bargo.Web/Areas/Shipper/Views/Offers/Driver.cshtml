@model ShipperDriverProfileVm
@{
    var here = Context.Request.Path.Value + Context.Request.QueryString.Value;
    var doneWithMe = Model.TripsWithMe.Count(x => TripStatus.Done.Contains(x.Status));
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-person-badge"></i> @Model.Name @Ui.AccountPill(Model.Status)</h1>
        <p>
            @(Model.CompanyName is null ? "رانندهٔ مستقل" : "رانندهٔ شرکت " + Model.CompanyName)@(Model.City is null ? "" : " · " + Model.City)
            · عضو بارگو از @Fa.LongDate(Model.MemberSince) · @Ui.Stars(Model.RatingAvg, Model.RatingCount)
        </p>
    </div>
    <div class="actions">
        @if (Model.IsFavorite)
        {
            <form method="post" asp-controller="Drivers" asp-action="Unfavorite" class="inline" data-confirm="@Model.Name از رانندگان مورد علاقه حذف شود؟">
                <input type="hidden" name="driverId" value="@Model.DriverId" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="btn2 ghost"><i class="bi bi-heart-fill"></i> مورد علاقه</button>
            </form>
        }
        else
        {
            <form method="post" asp-controller="Drivers" asp-action="Favorite" class="inline">
                <input type="hidden" name="driverId" value="@Model.DriverId" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="btn2 soft"><i class="bi bi-heart"></i> افزودن به مورد علاقه</button>
            </form>
        }
        <a class="btn2 ghost" href="/Shipper/Offers"><i class="bi bi-arrow-right"></i> پیشنهادها</a>
    </div>
</div>

@if (Model.Status != AccountStatus.Approved)
{
    <div class="alert2 warn"><i class="bi bi-exclamation-triangle-fill"></i><div class="grow">حساب این راننده در وضعیت «@AccountStatus.Label(Model.Status)» است و تا فعال شدن، پیشنهادش پذیرفته نمی‌شود.</div></div>
}

<div class="stats">
    <div class="stat p"><div class="l"><i class="bi bi-star"></i> امتیاز</div><div class="v">@(Model.RatingCount == 0 ? "—" : Fa.N(Model.RatingAvg, 1))<small>@(Model.RatingCount == 0 ? "بدون امتیاز" : "از " + Fa.N(Model.RatingCount) + " نظر")</small></div></div>
    <div class="stat t"><div class="l"><i class="bi bi-signpost-split"></i> سفرهای انجام‌شده</div><div class="v">@Fa.N(Model.TripCount)</div></div>
    <div class="stat s"><div class="l"><i class="bi bi-check2-all"></i> تحویل موفق با شما</div><div class="v">@Fa.N(doneWithMe)</div></div>
    <div class="stat i"><div class="l"><i class="bi bi-patch-check"></i> مدارک معتبر</div><div class="v">@Fa.N(Model.Docs.Count(x => x.ExpiresAt is null || x.ExpiresAt >= DateTime.UtcNow))</div></div>
</div>

<div class="grid-side">
    <div class="stack">
        @if (Model.OffersOnMyLoads.Count > 0)
        {
            <div class="card2">
                <div class="hd"><i class="bi bi-tags"></i> پیشنهادهای در انتظار روی بارهای شما</div>
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th>بار</th><th>مبلغ</th><th>رسیدن به مبدا</th><th>خودرو</th><th>توضیح</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var o in Model.OffersOnMyLoads)
                        {
                            <tr>
                                <td><a class="lnk" href="/Shipper/Loads/Detail/@o.LoadId">مشاهدهٔ بار</a><span class="sub">ثبت پیشنهاد @Fa.Ago(o.CreatedAt)</span></td>
                                <td class="nowrap"><b class="num">@Fa.Toman(o.Amount)</b></td>
                                <td>@(o.EtaHours is int eta ? Fa.N(eta) + " ساعت" : "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(o.PlateNo))
                                    {
                                        <partial name="_Plate" model="o.PlateNo" /><span class="sub">@o.VehicleType</span>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td class="small">@(string.IsNullOrWhiteSpace(o.Note) ? "—" : o.Note)</td>
                                <td>
                                    <div class="row-actions">
                                        <a class="btn2 pri sm" href="/Shipper/Offers/Compare/@o.LoadId"><i class="bi bi-bar-chart-steps"></i> مقایسه</a>
                                        <form method="post" asp-action="Accept" asp-route-id="@o.OfferId" class="inline"
                                              data-confirm="پیشنهاد @Model.Name با مبلغ @Fa.Toman(o.Amount) پذیرفته شود؟ پیشنهادهای دیگر این بار رد می‌شوند و باید کرایه را پرداخت کنید.">
                                            <button type="submit" class="btn2 grn sm"><i class="bi bi-check2"></i> پذیرش</button>
                                        </form>
                                        <a class="btn2 ghost sm" href="@Url.Action("Thread", "Messages", new { key = "offer:" + o.OfferId })" title="پیام به راننده"><i class="bi bi-chat-dots"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card2">
            <div class="hd"><i class="bi bi-truck-front"></i> خودروها</div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>پلاک</th><th>نوع</th><th>مدل</th><th>ظرفیت</th><th>بیمه</th><th>معاینه فنی</th><th>وضعیت</th></tr></thead>
                    <tbody>
                    @foreach (var v in Model.Vehicles)
                    {
                        var makeModel = string.Join(" ", new[] { v.Brand, v.Model }.Where(x => !string.IsNullOrWhiteSpace(x)));
                        <tr>
                            <td><partial name="_Plate" model="v.PlateNo" />@if (v.CompanyId is not null) { <span class="sub">خودروی شرکت</span> }</td>
                            <td>@(v.VehicleType?.Name ?? "—")@if (!string.IsNullOrEmpty(v.VehicleType?.BodyKind)) { <span class="sub">@v.VehicleType.BodyKind</span> }</td>
                            <td>@(makeModel.Length == 0 ? "—" : makeModel)@if (v.Year is int yr) { <span class="sub">@Fa.Digits(yr.ToString())</span> }</td>
                            <td class="nowrap">@ShipperUi.Ton(v.CapacityTon)</td>
                            <td>@Ui.Expiry(v.InsuranceExpiresAt)</td>
                            <td>@Ui.Expiry(v.InspectionExpiresAt)</td>
                            <td>@Ui.VehiclePill(v.Status)<span class="sub">@Ui.Pill(ShipperUi.VerifyLabel(v.VerifyStatus), ShipperUi.VerifyTone(v.VerifyStatus))</span></td>
                        </tr>
                    }
                    @if (Model.Vehicles.Count == 0)
                    {
                        <tr><td colspan="7" class="empty"><i class="bi bi-truck-front"></i>خودرویی برای این راننده ثبت نشده است@(Model.CompanyName is null ? "." : "؛ خودروی شرکت هنگام تخصیص سفر مشخص می‌شود.")</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-clock-history"></i> سفرهای این راننده برای شما</div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>سفارش</th><th>مسیر</th><th>خودرو</th><th>کرایه</th><th>وضعیت</th><th>تاریخ</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.TripsWithMe)
                    {
                        <tr data-href="/Shipper/Orders/Detail/@t.TripId">
                            <td><a class="lnk num" href="/Shipper/Orders/Detail/@t.TripId">@t.Code</a><span class="sub">@t.LoadTitle</span></td>
                            <td>@Ui.Route(t.From, t.To)</td>
                            <td>@if (!string.IsNullOrEmpty(t.PlateNo)) { <partial name="_Plate" model="t.PlateNo" /> } else { <span class="muted">—</span> }</td>
                            <td class="nowrap">@Fa.Toman(t.Fare)</td>
                            <td>@Ui.TripPill(t.Status)</td>
                            <td class="nowrap">@Fa.Date(t.DeliveredAt ?? t.CancelledAt ?? t.CreatedAt)</td>
                        </tr>
                    }
                    @if (Model.TripsWithMe.Count == 0)
                    {
                        <tr><td colspan="6" class="empty"><i class="bi bi-signpost-split"></i>این راننده هنوز باری برای شما حمل نکرده است.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="stack">
        <div class="card2">
            <div class="hd"><i class="bi bi-patch-check"></i> مدارک تأییدشده</div>
            <div class="bd">
                @foreach (var doc in Model.Docs)
                {
                    <div class="kvrow">
                        <span><b>@DocumentKind.Label(doc.Kind)</b> · @doc.Subject</span>
                        @if (doc.ExpiresAt is null)
                        {
                            @Ui.Pill("تأییدشده", "ok")
                        }
                        else
                        {
                            @Ui.Expiry(doc.ExpiresAt)
                        }
                    </div>
                }
                @if (Model.Docs.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-folder2"></i><b>مدرک تأییدشده‌ای نیست</b>مدیر بارگو هنوز مدرکی از این راننده یا خودروهایش تأیید نکرده است.</div>
                }
                else
                {
                    <p class="muted small" style="margin:10px 0 0">تاریخ کنار هر مدرک، پایان اعتبار آن است؛ قرمز یعنی منقضی و کهربایی یعنی کمتر از یک ماه مانده.</p>
                }
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-chat-quote"></i> نظرات صاحبان بار <span class="end muted small">@Fa.N(Model.Reviews.Count) نظر اخیر</span></div>
            <div class="bd">
                @foreach (var rv in Model.Reviews)
                {
                    <div class="kvrow">
                        <span>@(string.IsNullOrWhiteSpace(rv.Comment) ? "بدون متن" : rv.Comment)<br /><small class="muted">@Fa.Date(rv.CreatedAt)</small></span>
                        <span class="stars"><i class="bi bi-star-fill"></i> @Fa.N(rv.Score)</span>
                    </div>
                }
                @if (Model.Reviews.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-chat-square"></i><b>هنوز نظری ثبت نشده</b>پس از هر تحویل، صاحب بار می‌تواند به راننده امتیاز بدهد.</div>
                }
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-shield-lock"></i> حریم خصوصی</div>
            <div class="bd">
                <p class="muted small" style="margin:0">شمارهٔ تماس راننده پس از پذیرش پیشنهاد در صفحهٔ سفارش نمایش داده می‌شود. پیش از آن از «پیام» گفتگو کنید.</p>
            </div>
        </div>
    </div>
</div>

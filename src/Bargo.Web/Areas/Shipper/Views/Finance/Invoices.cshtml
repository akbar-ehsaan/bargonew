@model PageVm<Invoice>
@{
    var sum = (long)ViewBag.Sum;
}
<div class="page-head">
    <div><h1><i class="bi bi-receipt-cutoff"></i> فاکتورها</h1><p>فاکتور کرایهٔ حمل برای هر سفر تحویل‌شده و سایر صورت‌حساب‌هایی که به نام شما صادر شده است.</p></div>
    <div class="actions"><span class="chip"><i class="bi bi-calculator"></i> جمع کل: @Fa.Toman(sum)</span></div>
</div>

<div class="card2">
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>شماره فاکتور</th><th>تاریخ صدور</th><th>بابت</th><th>سفر</th><th>مبلغ</th><th>مالیات</th><th>جمع</th><th>وضعیت</th></tr></thead>
            <tbody>
            @foreach (var inv in Model.Rows)
            {
                <tr>
                    <td dir="ltr" style="text-align:right"><b>@inv.No</b></td>
                    <td class="nowrap">@Fa.Date(inv.IssuedAt)</td>
                    <td>@ShipperUi.InvoiceKindLabel(inv.Kind)</td>
                    <td>
                        @if (inv.TripId is int invTripId)
                        {
                            <a class="lnk" href="/Shipper/Orders/Detail/@invTripId">@(inv.Trip?.Code ?? "جزئیات سفر")</a>
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </td>
                    <td class="num nowrap">@Fa.Toman(inv.Amount)</td>
                    <td class="num nowrap">@(inv.Tax == 0 ? "—" : Fa.Toman(inv.Tax))</td>
                    <td class="nowrap"><b class="num">@Fa.Toman(inv.Total)</b></td>
                    <td>@(inv.Status == "paid" ? Ui.Pill("پرداخت‌شده", "ok") : Ui.Pill("در انتظار پرداخت", "wait"))</td>
                </tr>
            }
            @if (Model.Total == 0)
            {
                <tr><td colspan="8" class="empty"><i class="bi bi-receipt"></i>فاکتوری به نام شما صادر نشده است. پس از تحویل اولین بار، فاکتور کرایهٔ حمل اینجا می‌نشیند.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>

@model PageVm<DriverRow>
@{
    var q = ViewBag.Q as string;
    var status = ViewBag.Status as string;
    var kind = ViewBag.Kind as string;
    var sort = (string)ViewBag.Sort;
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    int C(string s) => counts.TryGetValue(s, out var n) ? n : 0;
    string[] tabs = [AccountStatus.Pending, AccountStatus.Approved, AccountStatus.Suspended, AccountStatus.Rejected];
    (string Key, string Label)[] sorts = [("new", "تازه‌ترین"), ("trips", "بیشترین سفر"), ("cancelled", "بیشترین لغو"), ("rating", "بالاترین امتیاز"), ("violations", "بیشترین تخلف")];
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-clock-history"></i> سوابق رانندگان</h1>
        <p>همهٔ رانندگان با سفرهای تحویل‌شده، لغوها، امتیاز، شرکت و وضعیت حساب. برای پروندهٔ کامل (مدارک، خودرو، کیف پول، تخلفات، شکایات) روی ردیف بزنید.</p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" asp-action="Pending"><i class="bi bi-person-check"></i> صف تأیید</a>
        <a class="btn2 ghost" asp-action="Ratings"><i class="bi bi-star"></i> امتیاز</a>
        <a class="btn2 ghost" asp-action="Violations"><i class="bi bi-exclamation-octagon"></i> تخلفات</a>
    </div>
</div>

<div class="tabs">
    <a asp-action="Index" asp-route-q="@q" asp-route-kind="@kind" asp-route-sort="@sort" class="@(status is null ? "on" : "")">همه <span class="n">@Fa.N(counts.Values.Sum())</span></a>
    @foreach (var s in tabs)
    {
        <a asp-action="Index" asp-route-status="@s" asp-route-q="@q" asp-route-kind="@kind" asp-route-sort="@sort" class="@(status == s ? "on" : "")">@AccountStatus.Label(s) <span class="n">@Fa.N(C(s))</span></a>
    }
</div>

<div class="card2">
    <form method="get" asp-action="Index" class="filters">
        <input type="hidden" name="status" value="@status" />
        <div class="fld"><label for="q">جستجو</label><input id="q" name="q" value="@q" placeholder="نام، موبایل یا کد ملی" /></div>
        <div class="fld narrow">
            <label>نوع</label>
            <select name="kind">
                <option value="">همه</option>
                <option value="independent" selected="@(kind == "independent")">مستقل</option>
                <option value="company" selected="@(kind == "company")">عضو شرکت</option>
            </select>
        </div>
        <div class="fld narrow">
            <label>ترتیب</label>
            <select name="sort">
                @foreach (var s in sorts)
                {
                    <option value="@s.Key" selected="@(sort == s.Key)">@s.Label</option>
                }
            </select>
        </div>
        <div class="row-actions">
            <button class="btn2 pri"><i class="bi bi-funnel"></i> اعمال</button>
            @if (!string.IsNullOrEmpty(q) || kind is not null || sort != "new")
            {
                <a class="btn2 ghost" asp-action="Index" asp-route-status="@status">پاک کردن</a>
            }
        </div>
    </form>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>راننده</th><th>شهر</th><th>شرکت</th><th>سفر تحویل‌شده</th><th>لغوشده</th><th>امتیاز</th><th>تخلف</th><th>وضعیت</th><th>آخرین حضور</th><th>عضویت</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr data-href="/Admin/Users/Driver/@r.DriverId">
                    <td><a class="lnk" href="/Admin/Users/Driver/@r.DriverId">@r.FullName</a><span class="sub num">@r.Mobile · @r.NationalCode</span></td>
                    <td>@(r.City ?? "—")</td>
                    <td>
                        @if (r.CompanyId is int cid)
                        {
                            <a class="lnk" href="/Admin/Users/Company/@cid">@r.CompanyName</a>
                        }
                        else
                        {
                            <span class="chip">مستقل</span>
                        }
                    </td>
                    <td class="num">@Fa.N(r.TripCount)</td>
                    <td class="num">
                        @if (r.Cancelled > 0)
                        {
                            <span style="color:var(--no);font-weight:800">@Fa.N(r.Cancelled)</span>
                        }
                        else
                        {
                            <span class="muted">۰</span>
                        }
                    </td>
                    <td>@Ui.Stars(r.RatingAvg, r.RatingCount)</td>
                    <td class="num">@(r.Violations > 0 ? Fa.N(r.Violations) : "—")</td>
                    <td>
                        @Ui.AccountPill(r.Status)
                        @if (!string.IsNullOrEmpty(r.StatusReason))
                        {
                            <span class="sub">@r.StatusReason</span>
                        }
                    </td>
                    <td class="nowrap">@(r.LastSeenAt is DateTime ls ? Fa.Ago(ls) : "—")</td>
                    <td class="nowrap">@Fa.Date(r.CreatedAt)</td>
                </tr>
            }
            @if (Model.Total == 0)
            {
                <tr><td colspan="10" class="empty"><i class="bi bi-person-badge"></i>راننده‌ای با این شرایط پیدا نشد.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>

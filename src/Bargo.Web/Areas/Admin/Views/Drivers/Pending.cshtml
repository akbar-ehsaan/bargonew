@model PageVm<PendingDriverVm>
@{
    var q = ViewBag.Q as string;
    var warnDays = (int)ViewBag.WarnDays;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-person-check"></i> تأیید راننده</h1>
        <p>رانندگان در انتظار تأیید — قدیمی‌ترین اول. چک‌لیست مدارک راننده و خودروی فعالش همین‌جاست؛ «آمادهٔ تأیید» یعنی هیچ مانعی برای گرفتن بار ندارد. رد بدون علت پذیرفته نمی‌شود.</p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" asp-action="Index"><i class="bi bi-clock-history"></i> همهٔ رانندگان</a>
        <a class="btn2 ghost" href="/Admin/Documents?status=pending&owner=driver"><i class="bi bi-folder2-open"></i> مدارک رانندگان در صف</a>
    </div>
</div>

<div class="card2">
    <form method="get" asp-action="Pending" class="filters">
        <div class="fld"><label for="q">جستجو</label><input id="q" name="q" value="@q" placeholder="نام، موبایل یا کد ملی" /></div>
        <button class="btn2 pri"><i class="bi bi-search"></i> جستجو</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a class="btn2 ghost" asp-action="Pending">پاک کردن</a>
        }
        <span class="muted small" style="margin-inline-start:auto">@Fa.N(Model.Total) راننده در انتظار</span>
    </form>

    @if (Model.Total == 0)
    {
        <div class="empty-state"><i class="bi bi-person-check"></i><b>راننده‌ای در انتظار تأیید نیست</b>@(string.IsNullOrEmpty(q) ? "هر رانندهٔ تازه‌ای که ثبت‌نام کند اینجا می‌آید." : "راننده‌ای با این مشخصات در صف نیست.")</div>
    }

    @foreach (var r in Model.Rows)
    {
        var d = r.Driver;
        var ready = DriverReadiness.IsReady(r.Issues);
        <div class="bd" style="border-bottom:1px solid var(--line-soft)">
            <div class="grid-side">
                <div>
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px">
                        <a class="lnk" href="/Admin/Users/Driver/@d.DriverId" style="font-size:16px">@d.FullName</a>
                        @if (ready)
                        {
                            @Ui.Pill("آمادهٔ تأیید", "ok")
                        }
                        else
                        {
                            @Ui.Pill($"{Fa.N(r.Issues.Count(i => i.Blocking))} مانع", "wait")
                        }
                        @if (d.CompanyId is int cid)
                        {
                            <a class="chip" href="/Admin/Users/Company/@cid"><i class="bi bi-buildings"></i> @(d.Company?.Name)</a>
                        }
                        else
                        {
                            <span class="chip">مستقل</span>
                        }
                        <span class="muted small">ثبت‌نام @Fa.Ago(d.CreatedAt) · @Fa.Stamp(d.CreatedAt)</span>
                    </div>
                    <dl class="kv">
                        <dt>موبایل / کد ملی</dt><dd class="num">@d.Mobile · @d.NationalCode</dd>
                        <dt>شهر</dt><dd>@(d.City?.Name ?? "—")@(string.IsNullOrEmpty(d.Address) ? "" : " · " + d.Address)</dd>
                        <dt>گواهینامه</dt>
                        <dd>
                            @(d.LicenseNo ?? "ثبت نشده")
                            @if (d.LicenseExpiresAt is not null)
                            {
                                <text> · اعتبار تا </text>@Ui.Expiry(d.LicenseExpiresAt, warnDays)
                            }
                        </dd>
                        <dt>کارت هوشمند</dt>
                        <dd>
                            @(d.SmartCardNo ?? "ثبت نشده")
                            @if (d.SmartCardExpiresAt is not null)
                            {
                                <text> · اعتبار تا </text>@Ui.Expiry(d.SmartCardExpiresAt, warnDays)
                            }
                        </dd>
                        <dt>خودرو</dt>
                        <dd>
                            @if (r.Vehicle is null)
                            {
                                <span class="muted">@(d.CompanyId is null ? "خودرویی ثبت نکرده" : "رانندهٔ شرکت — خودرو هنگام تخصیص")</span>
                            }
                            else
                            {
                                @OpsUi.Plate(r.Vehicle.PlateNo)
                                <text> @(r.Vehicle.VehicleType?.Name) @(r.Vehicle.Brand is null ? "" : "· " + r.Vehicle.Brand) · </text>@Ui.AccountPill(r.Vehicle.VerifyStatus)
                            }
                        </dd>
                    </dl>

                    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:12px">
                        @foreach (var chk in r.Checklist)
                        {
                            @OpsUi.Check(chk)
                        }
                        @foreach (var chk in r.VehicleChecklist)
                        {
                            @OpsUi.Check(chk)
                        }
                        <a class="btn2 sm ghost" href="/Admin/Documents?status=pending&owner=driver:@d.DriverId"><i class="bi bi-folder2-open"></i> بررسی مدارک</a>
                    </div>

                    @if (r.Issues.Count > 0)
                    {
                        <ul class="timeline" style="margin-top:12px">
                            @foreach (var i in r.Issues)
                            {
                                <li>@(i.Blocking ? Ui.Pill("مانع", "no") : Ui.Pill("هشدار", "wait")) @i.Text</li>
                            }
                        </ul>
                    }
                </div>

                <div>
                    <form method="post" asp-action="SetStatus" asp-route-id="@d.DriverId" data-confirm="تصمیم دربارهٔ رانندهٔ «@d.FullName» ثبت شود؟ راننده با اعلان باخبر می‌شود.">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="fld">
                            <label>علت یا توضیح <span class="muted small">(برای رد الزامی؛ برای راننده ارسال می‌شود)</span></label>
                            <textarea name="reason" rows="3" maxlength="1000" placeholder="مثلاً: تصویر گواهینامه ناخوانا است"></textarea>
                        </div>
                        <div class="form-actions">
                            <button class="btn2 grn" name="status" value="approved"><i class="bi bi-check2-circle"></i> تأیید راننده</button>
                            <button class="btn2 red" name="status" value="rejected"><i class="bi bi-x-circle"></i> رد درخواست</button>
                        </div>
                        @if (!ready)
                        {
                            <div class="hint muted small" style="margin-top:8px"><i class="bi bi-info-circle"></i> تأیید حساب ممکن است، ولی تا رفع موانع بالا این راننده بار نمی‌گیرد.</div>
                        }
                    </form>
                </div>
            </div>
        </div>
    }
    <partial name="_Pager" model="Model.Pager" />
</div>

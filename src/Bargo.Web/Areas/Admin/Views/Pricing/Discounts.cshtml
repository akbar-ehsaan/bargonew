@model DiscountsVm
@{
    var e = Model.Edit;
    var isAmount = e?.Amount is not null;
    var now = DateTime.UtcNow;
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-ticket-perforated"></i> کد تخفیف</h1>
        <p>کد با حروف بزرگ لاتین ذخیره می‌شود؛ اعتبار از ابتدای روز شروع تا پایان روز آخر به وقت تهران است.</p>
    </div>
</div>

<div class="stats cols3">
    <div class="stat s"><div class="l"><i class="bi bi-check2-circle"></i> کدهای قابل استفاده</div><div class="v">@Fa.N(Model.ActiveCount)</div></div>
    <div class="stat t"><div class="l"><i class="bi bi-ticket-perforated"></i> کل کدها</div><div class="v">@Fa.N(Model.Page.Total)</div></div>
    <div class="stat i"><div class="l"><i class="bi bi-calendar-day"></i> امروز</div><div class="v">@Fa.Date(now)</div></div>
</div>

<div class="grid-side">
    <div class="card2">
        <div class="tbl-wrap">
            <table class="tbl">
                <thead><tr><th>کد</th><th>تخفیف</th><th>استفاده</th><th>اعتبار</th><th>وضعیت</th><th></th></tr></thead>
                <tbody>
                @foreach (var d in Model.Page.Rows)
                {
                    var expired = d.ValidTo is DateTime vt && vt < now;
                    var notYet = d.ValidFrom is DateTime vf && vf > now;
                    var exhausted = d.Used >= d.MaxUses;
                    <tr>
                        <td class="num"><b>@d.Code</b></td>
                        <td class="nowrap">@(d.Percent is int p ? Fa.N(p) + "٪" : Fa.Toman(d.Amount))</td>
                        <td class="nowrap">@Fa.N(d.Used) از @Fa.N(d.MaxUses)</td>
                        <td class="small nowrap">@(d.ValidFrom is null ? "از همیشه" : "از " + Fa.Date(d.ValidFrom))<br />@(d.ValidTo is null ? "بدون پایان" : "تا " + Fa.Date(d.ValidTo))</td>
                        <td>
                            @if (!d.IsActive)
                            {
                                @Ui.Pill("غیرفعال", "mut")
                            }
                            else if (expired)
                            {
                                @Ui.Pill("منقضی", "no")
                            }
                            else if (exhausted)
                            {
                                @Ui.Pill("تمام‌شده", "no")
                            }
                            else if (notYet)
                            {
                                @Ui.Pill("هنوز شروع نشده", "wait")
                            }
                            else
                            {
                                @Ui.Pill("فعال", "ok")
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <a class="btn2 sm soft" asp-action="Discounts" asp-route-edit="@d.DiscountCodeId" asp-route-page="@Model.Page.Page"><i class="bi bi-pencil"></i></a>
                                @if (d.Used == 0)
                                {
                                    <form method="post" asp-action="DeleteDiscount" asp-route-id="@d.DiscountCodeId" data-confirm="کد @d.Code حذف شود؟">
                                        <button class="btn2 sm ghost"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Page.Total == 0)
                {
                    <tr><td colspan="6" class="empty"><i class="bi bi-ticket-perforated"></i>کد تخفیفی تعریف نشده است.</td></tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Page.Pager" />
    </div>

    <div class="card2">
        <div class="hd"><i class="bi @(e is null ? "bi-plus-circle" : "bi-pencil-square")"></i> @(e is null ? "کد تازه" : "ویرایش " + e.Code)</div>
        <div class="bd">
            <form method="post" asp-action="SaveDiscount">
                @if (e is not null)
                {
                    <input type="hidden" name="id" value="@e.DiscountCodeId" />
                }
                <div class="form-grid">
                    <div class="fld full"><label>کد <span class="req">*</span></label><input name="code" value="@e?.Code" dir="ltr" maxlength="30" required style="text-transform:uppercase" placeholder="BARGO1405" /></div>
                    <div class="fld">
                        <label>نوع</label>
                        <select name="mode">
                            <option value="percent" selected="@(!isAmount)">درصد</option>
                            <option value="amount" selected="@isAmount">مبلغ ثابت</option>
                        </select>
                    </div>
                    <div class="fld"><label>سقف استفاده <span class="req">*</span></label><input name="maxUses" value="@(e?.MaxUses ?? 1)" inputmode="numeric" dir="ltr" required /></div>
                    <div class="fld"><label>درصد (۱ تا ۱۰۰)</label><input name="percent" value="@e?.Percent" inputmode="numeric" dir="ltr" /></div>
                    <div class="fld"><label>مبلغ (تومان)</label><input name="amountToman" class="money" value="@(e?.Amount is long a ? (a / 10).ToString() : "")" /></div>
                    <div class="fld"><label>اعتبار از</label><input name="validFrom" data-jdate value="@Fa.DateBox(e?.ValidFrom)" placeholder="بدون محدودیت" /></div>
                    <div class="fld"><label>اعتبار تا</label><input name="validTo" data-jdate value="@Fa.DateBox(e?.ValidTo)" placeholder="بدون پایان" /></div>
                    <div class="fld full"><label class="check"><input type="checkbox" name="isActive" value="true" checked="@(e?.IsActive ?? true)" /><input type="hidden" name="isActive" value="false" /> فعال</label></div>
                </div>
                <div class="form-actions">
                    <button class="btn2 pri"><i class="bi bi-check2"></i> ذخیره</button>
                    @if (e is not null)
                    {
                        <a class="btn2 ghost" asp-action="Discounts">انصراف</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@model PageVm<CompanyRow>
@{
    var q = ViewBag.Q as string;
    var status = ViewBag.Status as string;
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    int C(string s) => counts.TryGetValue(s, out var n) ? n : 0;
    string[] tabs = [AccountStatus.Pending, AccountStatus.Approved, AccountStatus.Suspended, AccountStatus.Rejected];
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-building-check"></i> تأیید شرکت‌ها</h1>
        <p>وضعیت حساب هر شرکت را همین‌جا تغییر دهید: تأیید، رد، تعلیق یا فعال‌سازی دوباره. رد و تعلیق علت می‌خواهند و شرکت اعلان می‌گیرد؛ تعلیق همان لحظه دسترسی کاربرانش را می‌بندد.</p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" asp-action="Requests"><i class="bi bi-envelope-paper"></i> درخواست‌های عضویت</a>
        <a class="btn2 ghost" asp-action="Activity"><i class="bi bi-activity"></i> وضعیت فعالیت</a>
    </div>
</div>

<div class="tabs">
    <a asp-action="Index" asp-route-q="@q" class="@(status is null ? "on" : "")">همه <span class="n">@Fa.N(counts.Values.Sum())</span></a>
    @foreach (var s in tabs)
    {
        <a asp-action="Index" asp-route-status="@s" asp-route-q="@q" class="@(status == s ? "on" : "")">@AccountStatus.Label(s) <span class="n">@Fa.N(C(s))</span></a>
    }
</div>

<div class="card2">
    <form method="get" asp-action="Index" class="filters">
        <input type="hidden" name="status" value="@status" />
        <div class="fld"><label for="q">جستجو</label><input id="q" name="q" value="@q" placeholder="نام شرکت، شناسهٔ ملی، مدیرعامل یا موبایل" /></div>
        <button class="btn2 pri"><i class="bi bi-search"></i> جستجو</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a class="btn2 ghost" asp-action="Index" asp-route-status="@status">پاک کردن</a>
        }
    </form>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>شرکت</th><th>مدیرعامل</th><th>شهر</th><th>ناوگان</th><th>سفر در راه</th><th>وضعیت</th><th>عضویت</th><th>اقدام</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td><a class="lnk" href="/Admin/Users/Company/@r.CompanyId">@r.Name</a><span class="sub num">@r.NationalId · @r.Mobile</span></td>
                    <td>@r.ManagerName</td>
                    <td>@(r.City ?? "—")</td>
                    <td class="nowrap">@Fa.N(r.Drivers) راننده<span class="sub">@Fa.N(r.Vehicles) خودرو</span></td>
                    <td class="num">@Fa.N(r.ActiveTrips)</td>
                    <td>
                        @Ui.AccountPill(r.Status)
                        @if (!string.IsNullOrEmpty(r.StatusReason))
                        {
                            <span class="sub">@r.StatusReason</span>
                        }
                    </td>
                    <td class="nowrap">@Fa.Date(r.CreatedAt)</td>
                    <td style="min-width:280px">
                        <form method="post" asp-action="SetStatus" asp-route-id="@r.CompanyId" class="row-actions"
                              data-confirm="وضعیت حساب شرکت «@r.Name» تغییر کند؟ شرکت با اعلان باخبر می‌شود.">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            @if (r.Status != AccountStatus.Approved)
                            {
                                <button class="btn2 sm grn" name="status" value="approved"><i class="bi bi-check2-circle"></i> @(r.Status == AccountStatus.Suspended ? "فعال‌سازی" : "تأیید")</button>
                            }
                            @if (r.Status is AccountStatus.Pending or AccountStatus.Approved)
                            {
                                <div class="fld" style="flex:1;min-width:130px"><input name="reason" placeholder="@(r.Status == AccountStatus.Pending ? "علت رد" : "علت تعلیق")" maxlength="1000" /></div>
                                @if (r.Status == AccountStatus.Pending)
                                {
                                    <button class="btn2 sm red" name="status" value="rejected"><i class="bi bi-x-circle"></i> رد</button>
                                }
                                else
                                {
                                    <button class="btn2 sm red" name="status" value="suspended"><i class="bi bi-pause-circle"></i> تعلیق</button>
                                }
                            }
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Total == 0)
            {
                <tr><td colspan="8" class="empty"><i class="bi bi-buildings"></i>شرکتی با این شرایط پیدا نشد.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>

@model CompanyDetailVm
@{
    var c = Model.Company;
    var ret = Context.Request.Path + Context.Request.QueryString;
    var pendingDocs = Model.Documents.Count(x => x.Status == AccountStatus.Pending);
    string Admin(int? id) => id is int a && Model.AdminNames.TryGetValue(a, out var n) ? n : "—";
    string TitleLabel(string t) => t switch { "owner" => "مدیر شرکت", "dispatcher" => "دیسپچر", "accountant" => "حسابدار", "viewer" => "ناظر", _ => t };
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-buildings"></i> @c.Name @Ui.AccountPill(c.Status)</h1>
        <p>
            شناسهٔ ملی <span class="num">@c.NationalId</span> · مدیرعامل @c.ManagerName · <span class="num">@c.Mobile</span>
            · @(c.City is null ? "بدون شهر" : $"{c.City.Name} ({c.City.Province?.Name})")
            · عضویت @Fa.Date(c.CreatedAt)
        </p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" asp-action="Companies"><i class="bi bi-arrow-right"></i> فهرست شرکت‌ها</a>
        <a class="btn2 ghost" href="/Admin/Finance?owner=company&ownerId=@c.CompanyId"><i class="bi bi-wallet2"></i> گردش کیف پول</a>
        <a class="btn2 ghost" href="/Admin/Documents?owner=company:@c.CompanyId"><i class="bi bi-folder2-open"></i> مدارک در صف</a>
    </div>
</div>

<div class="stats cols5">
    <div class="stat p"><div class="l"><i class="bi bi-people"></i> رانندگان</div><div class="v">@Fa.N(Model.Drivers.Count)</div></div>
    <div class="stat p"><div class="l"><i class="bi bi-truck-front"></i> خودروها</div><div class="v">@Fa.N(Model.Vehicles.Count)</div></div>
    <div class="stat @(Model.ActiveTrips > 0 ? "s" : "i")"><div class="l"><i class="bi bi-truck"></i> سفر در راه</div><div class="v">@Fa.N(Model.ActiveTrips)<small>از @Fa.N(Model.TripTotal)</small></div></div>
    <div class="stat @(c.WalletBalance < 0 ? "r" : "t")"><div class="l"><i class="bi bi-wallet2"></i> موجودی کیف پول</div><div class="v">@Fa.Toman(c.WalletBalance)</div></div>
    <div class="stat @(c.LicenseExpiresAt is DateTime le && le < DateTime.UtcNow ? "r" : "i")"><div class="l"><i class="bi bi-award"></i> مجوز فعالیت</div><div class="v" style="font-size:16px">@(c.LicenseNo is null ? "ثبت نشده" : Fa.Digits(c.LicenseNo)) @Ui.Expiry(c.LicenseExpiresAt, Model.WarnDays)</div></div>
</div>

<div class="grid-side">
    <div class="stack">
        <div class="card2">
            <div class="hd"><i class="bi bi-card-list"></i> مشخصات شرکت</div>
            <div class="bd">
                <dl class="kv">
                    <dt>شمارهٔ ثبت</dt><dd class="num">@(c.RegistrationNo ?? "—")</dd>
                    <dt>مجوز فعالیت</dt><dd><span class="num">@(c.LicenseNo ?? "—")</span> @Ui.Expiry(c.LicenseExpiresAt, Model.WarnDays)</dd>
                    <dt>مدیرعامل</dt><dd>@c.ManagerName <span class="muted num">@(c.ManagerNationalCode is null ? "" : "· کد ملی " + c.ManagerNationalCode)</span></dd>
                    <dt>تلفن</dt><dd class="num">@(c.Phone ?? "—")</dd>
                    <dt>ایمیل</dt><dd class="num">@(c.Email ?? "—")</dd>
                    <dt>نشانی</dt><dd>@(string.IsNullOrEmpty(c.Address) ? "—" : c.Address)</dd>
                    <dt>بانک / شبا</dt><dd><span>@(c.BankName ?? "")</span> <span class="num">@(c.Sheba ?? "—")</span></dd>
                    <dt>سهم پیش‌فرض راننده</dt><dd>@Fa.N(c.DriverSharePercent, 0)٪ از کرایهٔ خالص</dd>
                    <dt>درخواست مستقیم</dt><dd>@(c.AcceptsDirectRequests ? "می‌پذیرد" : "نمی‌پذیرد")</dd>
                    <dt>امتیاز</dt><dd>@Ui.Stars(c.RatingAvg, c.RatingCount)</dd>
                    <dt>تأیید حساب</dt><dd>@(c.ApprovedAt is null ? "هنوز تأیید نشده" : Fa.Stamp(c.ApprovedAt))</dd>
                </dl>
            </div>
        </div>

        <div class="card2">
            <div class="hd">
                <i class="bi bi-folder2-open"></i> مدارک شرکت
                <span class="end">
                    @foreach (var ch in Model.Checklist)
                    {
                        @Ui.Pill($"{DocumentKind.Label(ch.Kind)}: {ch.Text}", ch.Tone)
                    }
                </span>
            </div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>مدرک</th><th>شماره</th><th>انقضا</th><th>وضعیت</th><th>بررسی</th><th>بارگذاری</th><th>فایل</th></tr></thead>
                    <tbody>
                    @foreach (var x in Model.Documents)
                    {
                        <tr>
                            <td><b>@DocumentKind.Label(x.Kind)</b></td>
                            <td class="num">@(x.Number ?? "—")</td>
                            <td>@Ui.Expiry(x.ExpiresAt, Model.WarnDays)</td>
                            <td>
                                @Ui.AccountPill(x.Status)
                                @if (!string.IsNullOrEmpty(x.ReviewNote)) { <span class="sub">@x.ReviewNote</span> }
                            </td>
                            <td class="small">@(x.ReviewedAt is null ? "—" : $"{Admin(x.ReviewedByAdminId)} · {Fa.Date(x.ReviewedAt)}")</td>
                            <td class="nowrap">@Fa.Stamp(x.UploadedAt)</td>
                            <td>@OpsUi.File(x.FilePath)</td>
                        </tr>
                    }
                    @if (Model.Documents.Count == 0)
                    {
                        <tr><td colspan="7" class="empty"><i class="bi bi-file-earmark-x"></i>هنوز مدرکی بارگذاری نشده است.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-person-gear"></i> کاربران پنل شرکت</div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>نام</th><th>موبایل</th><th>نقش</th><th>وضعیت</th><th>آخرین ورود</th></tr></thead>
                    <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td><b>@u.Name</b>@if (u.IsOwner) { <span class="chip">مالک حساب</span> }</td>
                            <td class="num">@u.Mobile</td>
                            <td>@TitleLabel(u.Title)</td>
                            <td>@(u.IsActive ? Ui.Pill("فعال", "ok") : Ui.Pill("غیرفعال", "mut"))</td>
                            <td class="nowrap">@(u.LastLoginAt is DateTime ll ? Fa.Ago(ll) : "هرگز")</td>
                        </tr>
                    }
                    @if (Model.Users.Count == 0)
                    {
                        <tr><td colspan="5" class="empty"><i class="bi bi-person-x"></i>کاربری برای این شرکت تعریف نشده است — کسی نمی‌تواند وارد پنل شود.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-people"></i> رانندگان شرکت</div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>راننده</th><th>کد ملی</th><th>سفر تحویل‌شده</th><th>امتیاز</th><th>وضعیت</th><th>آخرین حضور</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Drivers)
                    {
                        <tr data-href="/Admin/Users/Driver/@r.DriverId">
                            <td><a class="lnk" href="/Admin/Users/Driver/@r.DriverId">@r.FullName</a><span class="sub num">@r.Mobile</span></td>
                            <td class="num">@r.NationalCode</td>
                            <td class="num">@Fa.N(r.TripCount)@if (r.Cancelled > 0) { <span class="sub">@Fa.N(r.Cancelled) لغوشده</span> }</td>
                            <td>@Ui.Stars(r.RatingAvg, r.RatingCount)</td>
                            <td>@Ui.AccountPill(r.Status)@if (r.Violations > 0) { <span class="sub">@Fa.N(r.Violations) تخلف</span> }</td>
                            <td class="nowrap">@(r.LastSeenAt is DateTime ls ? Fa.Ago(ls) : "—")</td>
                        </tr>
                    }
                    @if (Model.Drivers.Count == 0)
                    {
                        <tr><td colspan="6" class="empty"><i class="bi bi-people"></i>هنوز راننده‌ای به این شرکت افزوده نشده است.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-truck-front"></i> ناوگان <span class="end"><a class="btn2 sm ghost" href="/Admin/Fleet">همهٔ خودروها</a></span></div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>پلاک</th><th>نوع</th><th>مشخصات</th><th>ظرفیت</th><th>بیمه</th><th>معاینه فنی</th><th>وضعیت</th><th>تأیید</th></tr></thead>
                    <tbody>
                    @foreach (var v in Model.Vehicles)
                    {
                        <tr>
                            <td>@OpsUi.Plate(v.PlateNo)</td>
                            <td>@(v.VehicleType?.Name ?? "—")</td>
                            <td>@(string.Join(" ", new[] { v.Brand, v.Model, v.Year?.ToString() }.Where(s => !string.IsNullOrEmpty(s))) is { Length: > 0 } spec ? spec : "—")</td>
                            <td class="num">@OpsLabels.Ton(v.CapacityTon) تن</td>
                            <td>@Ui.Expiry(v.InsuranceExpiresAt, Model.WarnDays)</td>
                            <td>@Ui.Expiry(v.InspectionExpiresAt, Model.WarnDays)</td>
                            <td>@Ui.VehiclePill(v.Status)</td>
                            <td>@Ui.AccountPill(v.VerifyStatus)</td>
                        </tr>
                    }
                    @if (Model.Vehicles.Count == 0)
                    {
                        <tr><td colspan="8" class="empty"><i class="bi bi-truck-front"></i>خودرویی ثبت نشده است.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-signpost-split"></i> سفرها <span class="end"><span class="muted small">@Fa.N(Model.Trips.Count) از @Fa.N(Model.TripTotal) سفر اخیر</span></span></div>
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead><tr><th>سفر</th><th>مسیر</th><th>راننده / خودرو</th><th>کرایه</th><th>وضعیت</th><th>ثبت</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.Trips)
                    {
                        <tr data-href="/Admin/Trips/Case/@t.TripId">
                            <td><a class="lnk num" href="/Admin/Trips/Case/@t.TripId">@t.Code</a><span class="sub num">@t.LoadCode</span></td>
                            <td>@Ui.Route(t.From, t.To)</td>
                            <td>@(t.DriverName ?? "تعیین نشده")<span class="sub">@OpsUi.Plate(t.Plate)</span></td>
                            <td class="nowrap">@Fa.Toman(t.Fare)</td>
                            <td>@Ui.TripPill(t.Status)@if (t.IsProblem) { @Ui.Pill("مشکل‌دار", "no") }</td>
                            <td class="nowrap">@Fa.Date(t.CreatedAt)</td>
                        </tr>
                    }
                    @if (Model.Trips.Count == 0)
                    {
                        <tr><td colspan="6" class="empty"><i class="bi bi-signpost-split"></i>هنوز سفری نداشته است.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="grid2">
            <div class="card2">
                <div class="hd"><i class="bi bi-wallet2"></i> کیف پول <span class="end"><b>@Fa.Toman(c.WalletBalance)</b></span></div>
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th>زمان</th><th>نوع</th><th>مبلغ</th><th>مانده</th></tr></thead>
                        <tbody>
                        @foreach (var t in Model.Txns)
                        {
                            <tr>
                                <td class="nowrap">@Fa.Stamp(t.CreatedAt)</td>
                                <td>@WalletTxnKind.Label(t.Kind)@if (t.TripId is int tid) { <span class="sub"><a class="lnk" href="/Admin/Trips/Case/@tid">سفر</a>@(string.IsNullOrEmpty(t.Note) ? "" : " · " + t.Note)</span> } else if (!string.IsNullOrEmpty(t.Note)) { <span class="sub">@t.Note</span> }</td>
                                <td>@OpsUi.Signed(t.Amount)</td>
                                <td class="nowrap">@Fa.Toman(t.BalanceAfter)</td>
                            </tr>
                        }
                        @if (Model.Txns.Count == 0)
                        {
                            <tr><td colspan="4" class="empty"><i class="bi bi-wallet2"></i>تراکنشی ثبت نشده است.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card2">
                <div class="hd"><i class="bi bi-file-earmark-medical"></i> قراردادها</div>
                <div class="bd">
                    @foreach (var k in Model.Contracts)
                    {
                        <div class="kvrow">
                            <span><b>@k.Title</b>@(k.Customer is null ? "" : " — " + k.Customer.Name)<br /><small class="muted">@Fa.Date(k.StartsAt) تا @(k.EndsAt is null ? "نامحدود" : Fa.Date(k.EndsAt))@(k.Amount is long ka ? " · " + Fa.Toman(ka) : "")</small></span>
                            <span>@Ui.Pill(OpsUi.ContractLabel(k.Status), OpsUi.ContractTone(k.Status)) @OpsUi.File(k.FilePath)</span>
                        </div>
                    }
                    @if (Model.Contracts.Count == 0)
                    {
                        <div class="empty-state"><i class="bi bi-file-earmark"></i>قراردادی ثبت نشده است.</div>
                    }
                </div>
            </div>
        </div>

        <div class="grid2">
            <div class="card2">
                <div class="hd"><i class="bi bi-star"></i> امتیازها</div>
                <div class="bd">
                    @foreach (var r in Model.Ratings)
                    {
                        <div class="kvrow">
                            <span><span class="stars"><i class="bi bi-star-fill"></i> @Fa.N(r.Score)</span> @(string.IsNullOrEmpty(r.Comment) ? "" : "— " + r.Comment)<br /><small class="muted">@OwnerKind.Label(r.FromKind) · @Fa.Date(r.CreatedAt)</small></span>
                            @if (r.Trip is not null) { <a class="lnk num" href="/Admin/Trips/Case/@r.TripId">@r.Trip.Code</a> }
                        </div>
                    }
                    @if (Model.Ratings.Count == 0)
                    {
                        <div class="empty-state"><i class="bi bi-star"></i>هنوز امتیازی نگرفته است.</div>
                    }
                </div>
            </div>

            <div class="card2">
                <div class="hd"><i class="bi bi-exclamation-octagon"></i> تخلفات رانندگان شرکت</div>
                <div class="bd">
                    @foreach (var v in Model.Violations)
                    {
                        <div class="kvrow">
                            <span><b>@v.Title</b>@(v.Driver is null ? "" : " — " + v.Driver.FullName)<br /><small class="muted">@Fa.Date(v.CreatedAt)@if (v.TripId is int vt) { <text> · </text><a class="lnk" href="/Admin/Trips/Case/@vt">سفر</a> }</small></span>
                            <span>@Ui.Pill(OpsUi.PenaltyLabel(v.Penalty), OpsUi.PenaltyTone(v.Penalty))@if (v.FineAmount is long f) { <span class="sub num">@Fa.Toman(f)</span> }</span>
                        </div>
                    }
                    @if (Model.Violations.Count == 0)
                    {
                        <div class="empty-state"><i class="bi bi-shield-check"></i>تخلفی ثبت نشده است.</div>
                    }
                </div>
            </div>
        </div>

        <div class="card2">
            <div class="hd"><i class="bi bi-exclamation-diamond"></i> شکایات</div>
            <div class="bd">
                @foreach (var x in Model.Complaints)
                {
                    var against = x.AgainstKind == OwnerKind.Company && x.AgainstId == c.CompanyId;
                    <a class="kvrow" href="/Admin/Complaints/Detail/@x.ComplaintId">
                        <span>@Ui.Pill(against ? "علیه شرکت" : "از سوی شرکت", against ? "no" : "inf") <b>@x.Title</b><br /><small class="muted">@ComplaintKind.Label(x.Kind) · @Fa.Date(x.CreatedAt)@(x.Trip is null ? "" : " · " + x.Trip.Code)</small></span>
                        @Ui.ComplaintPill(x.Status)
                    </a>
                }
                @if (Model.Complaints.Count == 0)
                {
                    <div class="empty-state"><i class="bi bi-emoji-smile"></i>شکایتی ثبت نشده است.</div>
                }
            </div>
        </div>
    </div>

    <div class="stack">
        <partial name="_AccountActions" model="new AccountActionVm { Kind = OwnerKind.Company, Id = c.CompanyId, Name = c.Name, Status = c.Status, StatusReason = c.StatusReason, ReturnUrl = ret }" />

        @if (pendingDocs > 0)
        {
            <div class="alert2 warn"><i class="bi bi-hourglass-split"></i><div class="grow">@Fa.N(pendingDocs) مدرک این شرکت در انتظار بررسی است. <a class="lnk" href="/Admin/Documents?owner=company:@c.CompanyId">بررسی</a></div></div>
        }
        @if (Model.ActiveTrips > 0 && c.Status != AccountStatus.Approved)
        {
            <div class="alert2 err"><i class="bi bi-truck"></i><div class="grow">این شرکت @Fa.N(Model.ActiveTrips) سفر در راه دارد ولی کاربرانش به پنل دسترسی ندارند؛ پیگیری آن سفرها با شماست. <a class="lnk" href="/Admin/Live/Trips">سفرهای فعال</a></div></div>
        }

        <div class="card2">
            <div class="hd"><i class="bi bi-link-45deg"></i> پیوندها</div>
            <div class="bd">
                <a class="kvrow" href="/Admin/Companies/Licenses"><span><i class="bi bi-award"></i> مجوزهای شرکت‌ها</span><i class="bi bi-chevron-left"></i></a>
                <a class="kvrow" href="/Admin/Companies/Contracts"><span><i class="bi bi-file-earmark-medical"></i> قراردادها</span><i class="bi bi-chevron-left"></i></a>
                <a class="kvrow" href="/Admin/Finance/Payouts?owner=company"><span><i class="bi bi-building-check"></i> تسویه شرکت‌ها</span><i class="bi bi-chevron-left"></i></a>
                <a class="kvrow" href="/Admin/Trips?q=@c.Name"><span><i class="bi bi-signpost-split"></i> جستجوی سفرهای شرکت</span><i class="bi bi-chevron-left"></i></a>
            </div>
        </div>
    </div>
</div>

@model PageVm<DriverRow>
@{
    var q = ViewBag.Q as string;
    var status = ViewBag.Status as string;
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    int C(string s) => counts.TryGetValue(s, out var n) ? n : 0;
    string[] tabs = [AccountStatus.Pending, AccountStatus.Approved, AccountStatus.Suspended, AccountStatus.Rejected];
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-person-badge"></i> رانندگان</h1>
        <p>رانندگان مستقل و عضو شرکت‌ها. برای پرونده (مدارک، خودرو، سفرها، کیف پول، تخلفات) روی ردیف بزنید.</p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" href="/Admin/Drivers/Pending"><i class="bi bi-person-check"></i> صف تأیید راننده</a>
        <a class="btn2 ghost" href="/Admin/Drivers/Violations"><i class="bi bi-exclamation-octagon"></i> تخلفات</a>
    </div>
</div>

<div class="tabs">
    <a asp-action="Drivers" asp-route-q="@q" class="@(status is null ? "on" : "")">همه <span class="n">@Fa.N(counts.Values.Sum())</span></a>
    @foreach (var s in tabs)
    {
        <a asp-action="Drivers" asp-route-status="@s" asp-route-q="@q" class="@(status == s ? "on" : "")">@AccountStatus.Label(s) <span class="n">@Fa.N(C(s))</span></a>
    }
</div>

<div class="card2">
    <form method="get" class="filters">
        <input type="hidden" name="status" value="@status" />
        <div class="fld"><label for="q">جستجو</label><input id="q" name="q" value="@q" placeholder="نام، موبایل یا کد ملی" /></div>
        <button class="btn2 pri"><i class="bi bi-search"></i> جستجو</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a class="btn2 ghost" asp-action="Drivers" asp-route-status="@status">پاک کردن</a>
        }
    </form>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>راننده</th><th>کد ملی</th><th>شهر</th><th>نوع</th><th>سفر تحویل‌شده</th><th>امتیاز</th><th>وضعیت</th><th>آخرین حضور</th><th>عضویت</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr data-href="/Admin/Users/Driver/@r.DriverId">
                    <td><a class="lnk" href="/Admin/Users/Driver/@r.DriverId">@r.FullName</a><span class="sub num">@r.Mobile</span></td>
                    <td class="num">@r.NationalCode</td>
                    <td>@(r.City ?? "—")</td>
                    <td>
                        @if (r.CompanyId is int cid)
                        {
                            <a class="lnk" href="/Admin/Users/Company/@cid">@r.CompanyName</a>
                        }
                        else
                        {
                            <span class="chip">مستقل</span>
                        }
                    </td>
                    <td class="num">@Fa.N(r.TripCount)@if (r.Cancelled > 0)
                        {
                            <span class="sub">@Fa.N(r.Cancelled) لغوشده</span>
                        }</td>
                    <td>@Ui.Stars(r.RatingAvg, r.RatingCount)</td>
                    <td>
                        @Ui.AccountPill(r.Status)
                        @if (r.Violations > 0)
                        {
                            <span class="sub">@Fa.N(r.Violations) تخلف</span>
                        }
                    </td>
                    <td class="nowrap">@(r.LastSeenAt is DateTime ls ? Fa.Ago(ls) : "—")</td>
                    <td class="nowrap">@Fa.Date(r.CreatedAt)</td>
                </tr>
            }
            @if (Model.Total == 0)
            {
                <tr><td colspan="9" class="empty"><i class="bi bi-person-badge"></i>راننده‌ای با این شرایط پیدا نشد.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>

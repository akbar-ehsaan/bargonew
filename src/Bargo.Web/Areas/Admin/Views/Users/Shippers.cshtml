@model PageVm<ShipperRow>
@{
    var q = ViewBag.Q as string;
    var status = ViewBag.Status as string;
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    int C(string s) => counts.TryGetValue(s, out var n) ? n : 0;
    string[] tabs = [AccountStatus.Approved, AccountStatus.Suspended, AccountStatus.Rejected, AccountStatus.Pending];
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-person-workspace"></i> صاحبان بار</h1>
        <p>اشخاص حقیقی و کسب‌وکارها. حساب صاحب بار بی‌درنگ فعال است؛ احراز هویت جداست.</p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" href="/Admin/Users/Verifications"><i class="bi bi-patch-check"></i> صف احراز هویت</a>
    </div>
</div>

<div class="tabs">
    <a asp-action="Shippers" asp-route-q="@q" class="@(status is null ? "on" : "")">همه <span class="n">@Fa.N(counts.Values.Sum())</span></a>
    @foreach (var s in tabs)
    {
        if (C(s) == 0 && status != s && s == AccountStatus.Pending) { continue; }
        <a asp-action="Shippers" asp-route-status="@s" asp-route-q="@q" class="@(status == s ? "on" : "")">@AccountStatus.Label(s) <span class="n">@Fa.N(C(s))</span></a>
    }
</div>

<div class="card2">
    <form method="get" class="filters">
        <input type="hidden" name="status" value="@status" />
        <div class="fld"><label for="q">جستجو</label><input id="q" name="q" value="@q" placeholder="نام، نام کسب‌وکار، موبایل، کد/شناسهٔ ملی" /></div>
        <button class="btn2 pri"><i class="bi bi-search"></i> جستجو</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a class="btn2 ghost" asp-action="Shippers" asp-route-status="@status">پاک کردن</a>
        }
    </form>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>صاحب بار</th><th>نوع</th><th>کد / شناسهٔ ملی</th><th>شهر</th><th>بارها</th><th>کیف پول</th><th>احراز هویت</th><th>وضعیت حساب</th><th>عضویت</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr data-href="/Admin/Users/Shipper/@r.ShipperId">
                    <td>
                        <a class="lnk" href="/Admin/Users/Shipper/@r.ShipperId">@r.Name</a>
                        <span class="sub num">@r.Mobile@(r.Name != r.FullName ? " · " + r.FullName : "")</span>
                    </td>
                    <td>@(r.Kind == "business" ? "کسب‌وکار" : "شخص حقیقی")</td>
                    <td class="num">@(r.NationalId ?? r.NationalCode ?? "—")</td>
                    <td>@(r.City ?? "—")</td>
                    <td class="num">@Fa.N(r.Loads)</td>
                    <td class="nowrap">@Fa.Toman(r.WalletBalance)</td>
                    <td>
                        @if (r.VerifyStatus is null)
                        {
                            <span class="muted small">مدرکی نفرستاده</span>
                        }
                        else
                        {
                            @Ui.AccountPill(r.VerifyStatus)
                        }
                    </td>
                    <td>@Ui.AccountPill(r.Status)</td>
                    <td class="nowrap">@Fa.Date(r.CreatedAt)</td>
                </tr>
            }
            @if (Model.Total == 0)
            {
                <tr><td colspan="9" class="empty"><i class="bi bi-person-workspace"></i>صاحب باری با این شرایط پیدا نشد.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>

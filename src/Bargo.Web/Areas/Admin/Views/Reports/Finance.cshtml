@model ReportFinanceVm
<div class="page-head">
    <div>
        <h1><i class="bi bi-cash-stack"></i> گزارش مالی</h1>
        <p>کرایه و کمیسیون بر پایهٔ زمان تسویهٔ سفر؛ واریز، استرداد و شارژ بر پایهٔ زمان انجام. همهٔ مبالغ به تومان.</p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" href="/Admin/Finance/Revenue"><i class="bi bi-graph-up-arrow"></i> درآمد ۱۲ ماه</a>
        <a class="btn2 ghost" href="/Admin/Finance"><i class="bi bi-arrow-left-right"></i> تراکنش‌ها</a>
    </div>
</div>

<partial name="_Range" model="Model.Range" />

<div class="stats cols5" style="margin-top:18px">
    <div class="stat p"><div class="l"><i class="bi bi-truck"></i> کرایهٔ تسویه‌شده</div><div class="v">@Fa.Toman(Model.Fares)</div></div>
    <div class="stat s"><div class="l"><i class="bi bi-percent"></i> کمیسیون بارگو</div><div class="v">@Fa.Toman(Model.Commission)</div></div>
    <div class="stat w"><div class="l"><i class="bi bi-bank"></i> واریز به حمل‌کنندگان</div><div class="v">@Fa.Toman(Model.Payouts)</div></div>
    <div class="stat r"><div class="l"><i class="bi bi-arrow-counterclockwise"></i> استرداد</div><div class="v">@Fa.Toman(Model.Refunds)</div></div>
    <div class="stat i"><div class="l"><i class="bi bi-wallet2"></i> شارژ کیف پول</div><div class="v">@Fa.Toman(Model.Charges)</div></div>
</div>

<div class="card2">
    <div class="hd"><i class="bi bi-bar-chart"></i> روند بازه <span class="end muted small">@Fa.N(Model.SettledTrips) سفر تسویه‌شده · میانگین نرخ کمیسیون @(Model.Fares == 0 ? "—" : Fa.N(Model.Commission * 100.0 / Model.Fares, 2) + "٪")</span></div>
    <partial name="_Series" model="Model.Series" />
</div>

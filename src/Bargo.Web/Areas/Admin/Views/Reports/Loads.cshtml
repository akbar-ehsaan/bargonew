@model ReportLoadsVm
@{
    var maxCargo = Model.ByCargo.Count == 0 ? 0 : Model.ByCargo.Max(c => c.Count);
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-boxes"></i> گزارش بارها</h1>
        <p>بارهای ثبت‌شده در بازه و سرنوشت‌شان: قطعی‌شده (به سفر رسیده)، لغوشده یا منقضی — همه بر پایهٔ تاریخ ثبت بار.</p>
    </div>
    <div class="actions"><a class="btn2 ghost" href="/Admin/Loads"><i class="bi bi-list-ul"></i> فهرست بارها</a></div>
</div>

<partial name="_Range" model="Model.Range" />

<div class="stats" style="margin-top:18px">
    <div class="stat p"><div class="l"><i class="bi bi-plus-square"></i> ثبت‌شده</div><div class="v">@Fa.N(Model.Created)</div></div>
    <div class="stat s"><div class="l"><i class="bi bi-check2-circle"></i> قطعی‌شده</div><div class="v">@Fa.N(Model.Booked) <small>@(Model.Created == 0 ? "" : Fa.N(Model.Booked * 100.0 / Model.Created, 0) + "٪")</small></div></div>
    <div class="stat r"><div class="l"><i class="bi bi-x-octagon"></i> لغوشده</div><div class="v">@Fa.N(Model.Cancelled)</div></div>
    <div class="stat w"><div class="l"><i class="bi bi-hourglass-bottom"></i> منقضی</div><div class="v">@Fa.N(Model.Expired)</div></div>
</div>

<div class="card2">
    <div class="hd"><i class="bi bi-bar-chart"></i> روند بازه</div>
    <partial name="_Series" model="Model.Series" />
</div>

<div class="card2">
    <div class="hd"><i class="bi bi-box-seam"></i> بر پایهٔ نوع بار <span class="end muted small">پرتکرارترین‌ها</span></div>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>نوع بار</th><th style="min-width:240px">تعداد</th><th>قطعی‌شده</th><th>نرخ تبدیل</th><th>مجموع وزن</th></tr></thead>
            <tbody>
            @foreach (var c in Model.ByCargo)
            {
                <tr>
                    <td><b>@c.Cargo</b></td>
                    <td>
                        <div class="small">@Fa.N(c.Count) بار</div>
                        <div style="height:7px;border-radius:6px;background:var(--line-soft)"><div style="height:7px;border-radius:6px;background:var(--primary);width:@BackofficeFormat.Bar(c.Count, maxCargo)%"></div></div>
                    </td>
                    <td class="num">@Fa.N(c.Booked)</td>
                    <td class="nowrap">@(c.Count == 0 ? "—" : Fa.N(c.Booked * 100.0 / c.Count, 0) + "٪")</td>
                    <td class="nowrap">@Fa.N(c.WeightTon, 1) تن</td>
                </tr>
            }
            @if (Model.ByCargo.Count == 0)
            {
                <tr><td colspan="5" class="empty"><i class="bi bi-boxes"></i>در این بازه باری ثبت نشده است.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

@model PageVm<LoadRow>
@{
    var q = ViewBag.Q as string;
    var ret = Context.Request.Path + Context.Request.QueryString;
}
<div class="page-head">
    <div>
        <h1><i class="bi bi-flag"></i> بارهای گزارش‌شده</h1>
        <p>بارهایی که مدیر (یا گردش کار) به‌عنوان مشکوک، نامعتبر یا نیازمند بررسی علامت زده است. برداشتن گزارش، وضعیت بار را عوض نمی‌کند.</p>
    </div>
    <div class="actions">
        <a class="btn2 ghost" asp-action="Index"><i class="bi bi-arrow-right"></i> همهٔ بارها</a>
    </div>
</div>

<div class="card2">
    <form method="get" class="filters">
        <div class="fld"><label for="q">جستجو</label><input id="q" name="q" value="@q" placeholder="کد بار، عنوان، شهر یا صاحب بار" /></div>
        <button class="btn2 pri"><i class="bi bi-search"></i> جستجو</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a class="btn2 ghost" asp-action="Reported">پاک کردن</a>
        }
        <span class="muted small" style="margin-inline-start:auto">@Fa.N(Model.Total) بار گزارش‌شده</span>
    </form>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>بار</th><th>مسیر</th><th>صاحب بار</th><th>علت گزارش</th><th>وضعیت</th><th>سفر</th><th>ثبت</th><th>اقدام</th></tr></thead>
            <tbody>
            @foreach (var l in Model.Rows)
            {
                <tr data-href="/Admin/Loads/Detail/@l.LoadId">
                    <td><a class="lnk num" href="/Admin/Loads/Detail/@l.LoadId">@l.Code</a><span class="sub">@l.Title · @OpsLabels.Ton(l.WeightTon) تن</span></td>
                    <td>@Ui.Route(l.From, l.To)</td>
                    <td>
                        @if (l.ShipperId is int sid) { <a class="lnk" href="/Admin/Users/Shipper/@sid">@l.OwnerName</a> }
                        else if (l.CompanyId is int cid) { <a class="lnk" href="/Admin/Users/Company/@cid">@l.OwnerName</a> }
                        else { <span class="muted">—</span> }
                    </td>
                    <td class="small" style="max-width:320px">@(string.IsNullOrEmpty(l.ReportNote) ? "بدون شرح" : l.ReportNote)</td>
                    <td>@Ui.LoadPill(l.Status)</td>
                    <td>
                        @if (l.TripId is int tid) { <a class="lnk num" href="/Admin/Trips/Case/@tid">@l.TripCode</a> }
                        else { <span class="muted">—</span> }
                    </td>
                    <td class="nowrap">@Fa.Date(l.CreatedAt)</td>
                    <td>
                        <div class="row-actions">
                            <a class="btn2 sm ghost" href="/Admin/Loads/Detail/@l.LoadId"><i class="bi bi-folder2-open"></i> پرونده</a>
                            <form method="post" asp-action="ClearReport" class="inline" data-confirm="گزارش بار @l.Code برداشته شود؟">
                                <input type="hidden" name="id" value="@l.LoadId" />
                                <input type="hidden" name="returnUrl" value="@ret" />
                                <button class="btn2 sm soft"><i class="bi bi-flag"></i> برداشتن گزارش</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Total == 0)
            {
                <tr><td colspan="8" class="empty"><i class="bi bi-check2-circle"></i>@(string.IsNullOrEmpty(q) ? "هیچ بار گزارش‌شده‌ای نیست." : "بار گزارش‌شده‌ای با این مشخصات پیدا نشد.")</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>

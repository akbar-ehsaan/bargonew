@model List<Bargo.Web.Controllers.Shared.MessagesControllerBase.ThreadRow>
<div class="page-head">
    <div><h1><i class="bi bi-chat-dots"></i> پیام‌ها</h1><p>گفتگوها از صفحهٔ هر پیشنهاد یا سفر شروع می‌شوند.</p></div>
</div>
<div class="card2">
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>گفتگو</th><th>آخرین پیام</th><th>زمان</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr data-href="@Url.Action("Thread", new { key = r.Key })">
                    <td><b>@r.Title</b></td>
                    <td><span class="muted">@r.LastFrom:</span> @(r.LastBody.Length > 70 ? r.LastBody[..70] + "…" : r.LastBody)</td>
                    <td class="nowrap">@Fa.Ago(r.LastAt)</td>
                    <td>@if (r.Unread > 0) { @Ui.Pill(Fa.N(r.Unread) + " تازه", "wait") }</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="empty"><i class="bi bi-chat-square"></i>هنوز گفتگویی ندارید.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

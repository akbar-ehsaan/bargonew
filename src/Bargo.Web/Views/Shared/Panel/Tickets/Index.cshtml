@model PageVm<Ticket>
@{
    var status = ViewBag.Status as string;
}
<div class="page-head">
    <div><h1><i class="bi bi-life-preserver"></i> تیکت‌های پشتیبانی</h1><p>پاسخ پشتیبانی در همین صفحه و در اعلان‌ها نمایش داده می‌شود.</p></div>
    <div class="actions">
        <a class="btn2 pri" asp-action="Create"><i class="bi bi-plus-lg"></i> تیکت تازه</a>
        <a class="btn2 ghost" asp-action="Contact"><i class="bi bi-telephone"></i> تماس با پشتیبانی</a>
    </div>
</div>
<div class="tabs">
    <a asp-action="Index" class="@(status is null ? "on" : "")">همه</a>
    <a asp-action="Index" asp-route-status="open" class="@(status == "open" ? "on" : "")">باز</a>
    <a asp-action="Index" asp-route-status="closed" class="@(status == "closed" ? "on" : "")">بسته</a>
</div>
<div class="card2">
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>شماره</th><th>موضوع</th><th>دسته</th><th>اولویت</th><th>وضعیت</th><th>آخرین به‌روزرسانی</th></tr></thead>
            <tbody>
            @foreach (var t in Model.Rows)
            {
                <tr data-href="@Url.Action("Thread", new { id = t.TicketId })">
                    <td class="num">#@Fa.N(t.TicketId)</td>
                    <td><b>@t.Subject</b></td>
                    <td>@TicketCategory.Label(t.Category)</td>
                    <td>@Ui.Pill(TicketPriority.Label(t.Priority), TicketPriority.Tone(t.Priority))</td>
                    <td>@Ui.TicketPill(t.Status)</td>
                    <td>@Fa.Ago(t.UpdatedAt)</td>
                </tr>
            }
            @if (Model.Total == 0)
            {
                <tr><td colspan="6" class="empty"><i class="bi bi-inbox"></i>تیکتی ثبت نکرده‌اید.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>

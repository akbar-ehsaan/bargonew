@model RegisterVm
@{
    Layout = "_AuthLayout";
    ViewData["Skin"] = Model.Type switch { Roles.Driver => "skin-driver", Roles.Company => "skin-company", _ => "skin-shipper" };
    var cities = (IEnumerable<dynamic>)ViewBag.Cities;
    var types = (List<VehicleType>)ViewBag.VehicleTypes;
    var captcha = ViewBag.Captcha as string;
    string heading = Model.Type switch { Roles.Driver => "ثبت‌نام راننده", Roles.Company => "درخواست عضویت شرکت حمل‌ونقل", _ => "ثبت‌نام صاحب بار" };
    var provinces = cities.GroupBy(c => (string)c.Province).Select(g => g.Key).ToList();
    var currentProvince = Model.CityId is int cid0 ? cities.Where(c => (int)c.CityId == cid0).Select(c => (string)c.Province).FirstOrDefault() : null;
    var version = typeof(Program).Assembly.GetName().Version?.ToString(3);
}

<style>
    .login-back{display:block;font-size:13px;margin-bottom:6px}
    .login-logo{display:flex;flex-direction:column;align-items:center;gap:8px;margin:4px 0 14px;text-align:center}
    .login-logo img{width:56px;height:56px}
    .login-logo b{font-size:19px}
    .login-logo span{font-size:12.5px;color:var(--ink-faint)}
    .pass-wrap{position:relative}
    .pass-wrap input{padding-inline-end:44px}
    .pass-eye{position:absolute;inset-inline-end:6px;top:50%;transform:translateY(-50%);border:0;background:none;cursor:pointer;
      width:34px;height:34px;border-radius:8px;color:var(--ink-faint);font-size:17px}
    .pass-eye:hover{background:var(--line-soft, #eee)}
    .cap-row{display:flex;align-items:center;gap:10px}
    .cap-row .cap-q{flex:none;min-width:96px;text-align:center;font-weight:800;font-size:17px;letter-spacing:2px;
      padding:10px 14px;border-radius:10px;background:var(--line-soft, #eef1f4);user-select:none;font-variant-numeric:tabular-nums}
    .cap-row input{flex:1;text-align:center}
    .terms-box{border:1px solid var(--line, #ddd);border-radius:10px;padding:10px 14px;margin-bottom:4px}
    .terms-box summary{cursor:pointer;font-weight:700;font-size:13.5px}
    .terms-box .body{font-size:12.5px;color:var(--ink-faint);margin-top:8px;line-height:2}
    .linkrow{text-align:center}
    .login-ver{margin-top:14px;text-align:center;font-size:11.5px;color:var(--ink-faint)}
</style>

<a class="lnk login-back" href="/account/login"><i class="bi bi-arrow-right"></i> بازگشت به ورود</a>

<div class="login-logo">
    <img src="/img/logo.svg" alt="بارگو" />
    <b>@heading</b>
    <span>
        @switch (Model.Type)
        {
            case Roles.Driver:<text>پس از ثبت‌نام، مدارک را از پنل بارگذاری کنید. با تأیید مدیر، پذیرش بار فعال می‌شود.</text>break;
            case Roles.Company:<text>پس از ثبت، مدارک شرکت را بارگذاری کنید. پنل شرکت با تأیید مدیر بارگو فعال می‌شود.</text>break;
            default:<text>بلافاصله پس از ثبت‌نام می‌توانید بار ثبت کنید.</text>break;
        }
    </span>
</div>

<div class="tabs">
    <a href="/account/register?type=shipper" class="@(Model.Type == Roles.Shipper ? "on" : "")"><i class="bi bi-box-seam"></i> صاحب بار</a>
    <a href="/account/register?type=driver" class="@(Model.Type == Roles.Driver ? "on" : "")"><i class="bi bi-truck"></i> راننده</a>
    <a href="/account/register?type=company" class="@(Model.Type == Roles.Company ? "on" : "")"><i class="bi bi-buildings"></i> شرکت</a>
</div>

<form method="post" action="/account/register">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Type" />
    <div class="form-grid">
        @if (Model.Type == Roles.Driver)
        {
            <div class="fld full">
                <label>جنسیت</label>
                <div class="role-pick" style="margin:0">
                    <label><input type="radio" name="Gender" value="female" checked="@(Model.Gender == "female")" /> خانم</label>
                    <label><input type="radio" name="Gender" value="male" checked="@(Model.Gender is null or "male")" /> آقا</label>
                </div>
            </div>
            <div class="fld"><label>نام <span class="req">*</span></label><input asp-for="FirstName" /><span asp-validation-for="FirstName" class="val-err"></span></div>
            <div class="fld"><label>نام خانوادگی <span class="req">*</span></label><input asp-for="LastName" /></div>
            <div class="fld"><label>کد ملی <span class="req">*</span></label><input asp-for="NationalCode" inputmode="numeric" dir="ltr" /><span asp-validation-for="NationalCode" class="val-err"></span></div>
            <div class="fld"><label>شمارهٔ گواهینامه <span class="req">*</span></label><input asp-for="LicenseNo" dir="ltr" /><span asp-validation-for="LicenseNo" class="val-err"></span></div>
            <div class="fld"><label>شمارهٔ کارت هوشمند <span class="req">*</span></label><input asp-for="SmartCardNo" dir="ltr" /><span asp-validation-for="SmartCardNo" class="val-err"></span></div>
            <div class="fld">
                <label>نوع خودرو <span class="req">*</span></label>
                <select asp-for="VehicleTypeId">
                    <option value="">انتخاب کنید</option>
                    @foreach (var t in types)
                    {
                        <option value="@t.VehicleTypeId">@t.Name (@Fa.N(t.CapacityTon, 1) تن)</option>
                    }
                </select>
            </div>
            <div class="fld full">
                <label>پلاک خودرو <span class="req">*</span></label>
                <partial name="_PlateInput" model="@Model.PlateNo" />
                <span asp-validation-for="PlateNo" class="val-err"></span>
            </div>
        }
        else if (Model.Type == Roles.Company)
        {
            <div class="fld full"><label>نام شرکت <span class="req">*</span></label><input asp-for="CompanyName" /><span asp-validation-for="CompanyName" class="val-err"></span></div>
            <div class="fld"><label>شناسهٔ ملی <span class="req">*</span></label><input asp-for="NationalId" inputmode="numeric" dir="ltr" /><span asp-validation-for="NationalId" class="val-err"></span></div>
            <div class="fld"><label>شمارهٔ ثبت</label><input asp-for="RegistrationNo" dir="ltr" /></div>
            <div class="fld"><label>شمارهٔ مجوز فعالیت</label><input asp-for="LicenseNoCompany" /></div>
            <div class="fld"><label>نام مدیرعامل <span class="req">*</span></label><input asp-for="ManagerName" /><span asp-validation-for="ManagerName" class="val-err"></span></div>
            <div class="fld full"><label>شمارهٔ شبا</label><input asp-for="Sheba" dir="ltr" placeholder="IR…" /><span asp-validation-for="Sheba" class="val-err"></span></div>
        }
        else
        {
            <div class="fld full">
                <label>نوع صاحب بار</label>
                <div class="role-pick" style="margin:0">
                    <label><input type="radio" name="ShipperKind" value="person" checked="@(Model.ShipperKind != "business")" /> شخص حقیقی</label>
                    <label><input type="radio" name="ShipperKind" value="business" checked="@(Model.ShipperKind == "business")" /> شرکت / کسب‌وکار</label>
                </div>
            </div>
            <div class="fld full" data-only-person>
                <label>جنسیت</label>
                <div class="role-pick" style="margin:0">
                    <label><input type="radio" name="Gender" value="female" checked="@(Model.Gender == "female")" /> خانم</label>
                    <label><input type="radio" name="Gender" value="male" checked="@(Model.Gender is null or "male")" /> آقا</label>
                </div>
            </div>
            <div class="fld"><label>نام و نام خانوادگی <span class="req">*</span></label><input asp-for="FullName" /><span asp-validation-for="FullName" class="val-err"></span></div>
            <div class="fld"><label>نام کسب‌وکار</label><input asp-for="BusinessName" /><span asp-validation-for="BusinessName" class="val-err"></span></div>
        }

        <div class="fld"><label>موبایل <span class="req">*</span></label><input asp-for="Mobile" inputmode="tel" dir="ltr" placeholder="۰۹۱۲۳۴۵۶۷۸۹" /><span asp-validation-for="Mobile" class="val-err"></span></div>
        <div class="fld">
            <label>استان <span class="req">*</span></label>
            <select id="provincePick">
                <option value="">انتخاب کنید</option>
                @foreach (var p in provinces)
                {
                    <option value="@p" selected="@(currentProvince == p)">@p</option>
                }
            </select>
        </div>
        <div class="fld">
            <label>شهر <span class="req">*</span></label>
            <select asp-for="CityId" id="cityPick">
                <option value="">اول استان را انتخاب کنید</option>
                @foreach (var c in cities)
                {
                    <option value="@c.CityId" data-prov="@c.Province" selected="@(Model.CityId == (int)c.CityId)">@c.Name</option>
                }
            </select>
            <span asp-validation-for="CityId" class="val-err"></span>
        </div>
        <div class="fld">
            <label>گذرواژه <span class="req">*</span></label>
            <div class="pass-wrap">
                <input asp-for="Password" type="password" autocomplete="new-password" dir="ltr" />
                <button type="button" class="pass-eye" data-eye="Password" aria-label="نمایش گذرواژه" tabindex="-1"><i class="bi bi-eye"></i></button>
            </div>
            <span class="hint">دست‌کم ۶ نویسه.</span>
            <span asp-validation-for="Password" class="val-err"></span>
        </div>
        <div class="fld">
            <label>تکرار گذرواژه <span class="req">*</span></label>
            <div class="pass-wrap">
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" dir="ltr" />
                <button type="button" class="pass-eye" data-eye="ConfirmPassword" aria-label="نمایش گذرواژه" tabindex="-1"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="val-err"></span>
        </div>
        <div class="fld full">
            <label>حاصل عبارت زیر را وارد کنید <span class="req">*</span></label>
            <div class="cap-row">
                <span class="cap-q" dir="ltr" data-cap="@(ViewBag.CaptchaRaw as string)">@captcha</span>
                <input asp-for="Captcha" inputmode="numeric" maxlength="3" placeholder="پاسخ" autocomplete="off" dir="ltr" />
            </div>
            <span asp-validation-for="Captcha" class="val-err"></span>
        </div>
        <div class="fld full">
            <details class="terms-box">
                <summary><i class="bi bi-file-earmark-text"></i> قوانین و مقررات بارگو</summary>
                <div class="body">
                    بارگو بستر ارتباط صاحبان بار، رانندگان و شرکت‌های حمل‌ونقل است؛ مسئولیت درستی اطلاعات و مدارک با ثبت‌کننده است،
                    مبالغ تا تحویل بار نزد بارگو امانت می‌ماند و تحویل فقط با کد یکبارمصرف گیرنده قطعی می‌شود.
                    متن کامل در <a class="lnk" href="/Home/Terms" target="_blank">صفحهٔ قوانین</a>.
                </div>
            </details>
            <label class="check"><input type="checkbox" name="AcceptTerms" value="true" checked="@Model.AcceptTerms" /> <span>قوانین و مقررات بارگو را خوانده‌ام و می‌پذیرم.</span></label>
            <span asp-validation-for="AcceptTerms" class="val-err"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn2 pri lg block"><i class="bi bi-person-plus"></i> ثبت‌نام</button>
    </div>
</form>
<div class="linkrow">حساب دارید؟ <a class="lnk" href="/account/login">ورود</a></div>
<div class="login-ver">نسخهٔ @Fa.Digits(version ?? "0.1.0")</div>

<script>
    // استان ← شهر: فهرست شهرها با انتخاب استان فیلتر می‌شود (سبک پت‌اوآیدی)
    (function () {
        var prov = document.getElementById('provincePick'), city = document.getElementById('cityPick');
        if (!prov || !city) return;
        var filter = function (keepValue) {
            var p = prov.value;
            var kept = keepValue ? city.value : '';
            Array.prototype.forEach.call(city.options, function (o) {
                if (!o.value) return;
                o.hidden = p !== '' && o.getAttribute('data-prov') !== p;
            });
            if (!keepValue || (city.selectedOptions[0] && city.selectedOptions[0].hidden)) city.value = '';
            if (kept && !keepValue) city.value = kept;
        };
        prov.addEventListener('change', function () { filter(false); });
        filter(true);
    })();

    // نمایش/پنهان‌کردن گذرواژه
    document.querySelectorAll('.pass-eye').forEach(function (b) {
        b.addEventListener('click', function () {
            var inp = document.getElementById(b.getAttribute('data-eye'));
            if (!inp) return;
            var show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            b.firstElementChild.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    });

    // جنسیت فقط برای شخص حقیقی معنا دارد
    (function () {
        var kinds = document.querySelectorAll('input[name="ShipperKind"]');
        var g = document.querySelector('[data-only-person]');
        if (!kinds.length || !g) return;
        var sync = function () {
            var isPerson = document.querySelector('input[name="ShipperKind"]:checked').value === 'person';
            g.style.display = isPerson ? '' : 'none';
        };
        kinds.forEach(function (k) { k.addEventListener('change', sync); });
        sync();
    })();
</script>
